alm.","pos":"noun","synonyms":["effort","try","bid"],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":["apetempt","attemptability","attemptable","attempter","attemptive","unattempted","unattempting","reattempt","attemptless","nonattempt"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/attempt#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:e32336070d95af0f98","definition":"A substantial but unsuccessful effort (to commit a crime).","example":"Whoever voluntarily abandons the further commission of the offence or prevents its completion incurs no penalty for attempt.","pos":"noun","synonyms":["effort","try","bid"],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":["apetempt","attemptability","attemptable","attempter","attemptive","unattempted","unattempting","reattempt","attemptless","nonattempt"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/attempt#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:1c9201ed62a3cde119","definition":"An act of trying to commit suicide","example":"Her attempt was not successful, and resulted in her being hospitalized.","pos":"noun","synonyms":["effort","try","bid"],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":["apetempt","attemptability","attemptable","attempter","attemptive","unattempted","unattempting","reattempt","attemptless","nonattempt"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/attempt#English","license":"CC-BY-SA-4.0"}],"pronunciation":{"ipa":"/əˈtɛmpt/","us":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/24/En-us-attempt.ogg/En-us-attempt.ogg.mp3"},"wordFamily":["apetempt","attemptability","attemptable","attempter","attemptive","unattempted","unattempting","reattempt","attemptle