{"term":"X-ray","senses":[{"id":"kaikki:ee80e9be6e08f8dce4","definition":"A ray of short-wavelength electromagnetic radiation usually produced by bombarding a metal target in a vacuum. Used to create images of the internal structure of objects; this is possible because X-rays pass through most objects and can expose photographic film.","example":"X-rays are light with a wavelength between 0.1 and 10 nm.","pos":"noun","synonyms":["Röntgen radiation","Roentgen-ray"],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/X-ray#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:2f63b0a5b4dad645b0","definition":"A radiograph: an image made with X-rays.","example":"The doctor ordered some X-rays of my injured wrist.","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/X-ray#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:7db0adcd6669f9ea29","definition":"An X-ray machine, a machine for performing radiography.","example":"","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/X-ray#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:df60df922038eef2b5","definition":"A tactical motif where a piece exerts influence or control over a square, piece, or line indirectly through another intervening piece.","example":"","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/X-ray#English","li