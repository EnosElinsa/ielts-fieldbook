{"term":"get to","senses":[{"id":"kaikki:284bc6ea8036f9255b","definition":"To reach or arrive at (a physical or abstract destination, or state of doing a certain activity).","example":"I’ll call you when I get to the railway station.","pos":"verb","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"transitive","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/get_to#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:41a9e3af5679d0b4de","definition":"To go to or be located at (a particular place).","example":"Where has Jane got to? She was here just a moment ago.","pos":"verb","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/get_to#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:0f4301b91c08e77dc1","definition":"To be allowed to.","example":"You won't get to have any dessert until you finish your vegetables.","pos":"verb","synonyms":[],"antonyms":[],"collocations":[],"usage":"informal","register":"informal, transitive","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/get_to#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:cbe9edae23f45ed18f","definition":"To affect adversely; to upset or annoy.","example":"This job’s really getting to me. I don’t know how much longer I’ll last.","pos":"verb","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"transitive","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/get_to#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:06b29ce7525303ed74","definition":"To attack, intimidate or kill; to corrupt or bribe.","example":"He’s refusing to testify. I think the Mob got to him.","pos":"verb","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"transitive","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/get_to#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:a1c3ac29340aa32409","definition":"To begin (something); to get around to doing (something).","example":"He got to his chores in the afternoon.","pos":"verb","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"transitive","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/get_to#English","license":"CC-BY-SA-4.0"}],"pronunciation":{},"wordFamily":[]}