{"term":"murmur","senses":[{"id":"kaikki:feaaa2971feeb3a205","definition":"Any low, indistinct sound, like that of running water.","example":"The delightful murmur of water running over pebbles is heard a few yards off","pos":"noun","synonyms":["murmur","murmuration","susurration","susurrus"],"antonyms":["din","silence"],"collocations":[],"usage":"","register":"countable, uncountable","wordFamily":["heart murmur","murmur diphthong","murmurish","Still's murmur","without a murmur"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/murmur#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:05ca12343db8fed4f4","definition":"Soft indistinct speech.","example":"A murmur arose from the audience.","pos":"noun","synonyms":["murmur","murmuration","susurration","susurrus"],"antonyms":["din","silence"],"collocations":[],"usage":"","register":"countable, uncountable","wordFamily":["heart murmur","murmur diphthong","murmurish","Still's murmur","without a murmur"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/murmur#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:fba91be90322e02d1b","definition":"The sound made by any condition which produces a noisy, or turbulent, flow of blood through the heart.","example":"Since aortic diastolic pressure is higher than pulmonary artery systolic pressure, there is continuous flow into the pulmonary circulation, creating the characteristic continuous (\"machinery\") murmur, heard best just below the left clavicle.","pos":"noun","synonyms":["murmur","murmuration","susurration","susurrus"],"antonyms":["din","silence"],"collocations":[],"usage":"","register":"countable, uncountable","wordFamily":["heart murmur","murmur diphthong","murmurish","Still's murmur","without a murmur"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/murmur#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:ae84377da211f20844","definition":"A muttered complaint or protest; the expression of dissatisfaction in a low muttering voice; any expression of complaint or discontent.","example":"In fear of disease and in the interest of his health man will be muzzled and masked like a vicious dog, and that without any murmur of complaint.","pos":"noun","synonyms":["murmur","murmuration","susurration","susurrus"],"antonyms":["din","silence"],"collocations":[],"usage":"","register":"countable, uncountable","wordFamily":["heart murmur","murmur diphthong","murmurish","Still's murmur","without a murmur"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/murmur#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:683e997ae1b8ebf9d5","definition":"To grumble; to complain in a low, muttering voice, or express discontent at or against someone or something.","example":"The Iewes then murmured at him because he sayde: I am that breed which is come doune from heaven.","pos":"verb","synonyms":[],"antonyms":[],"collocations":[],"usage":"archaic","register":"archaic, intransitive","wordFamily":["heart murmur","murmur diphthong","murmurish","Still's murmur","without a murmur","murmuration","murmurer","murmuring","murmuringly","murmurless","murmurous","remurmur","unmurmured","unmurmuring"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/murmur#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:9360f33422e5218bfc","definition":"To speak or make low, indistinguishable noise; to mumble, mutter.","example":"I couldn't hear the words; he just murmured a lot.","pos":"verb","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"intransitive","wordFamily":["heart murmur","murmur diphthong","murmurish","Still's murmur","without a murmur","murmuration","murmurer","murmuring","murmuringly","murmurless","murmurous","remurmur","unmurmured","unmurmuring"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/murmur#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:97e764e208d43a1d9b","definition":"To say (something) indistinctly, to mutter.","example":"I […] heard thee murmur tales of iron wars;","pos":"verb","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"transitive","wordFamily":["heart murmur","murmur diphthong","murmurish","Still's murmur","without a murmur","murmuration","murmurer","murmuring","murmuringly","murmurless","murmurous","remurmur","unmurmured","unmurmuring"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/murmur#English","license":"CC-BY-SA-4.0"}],"pronunciation":{"ipa":"/ˈmɜːmə/","us":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/73/En-us-murmur.ogg/En-us-murmur.ogg.mp3"},"wordFamily":["heart murmur","murmur diphthong","murmurish","Still's murmur","without a murmur","murmuration","murmurer","murmuring","murmuringly","murmurless","murmurous","remurmur","unmurmured","unmurmuring"]}