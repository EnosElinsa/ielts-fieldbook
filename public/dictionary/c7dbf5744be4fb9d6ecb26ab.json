{"term":"paraphrase","senses":[{"id":"kaikki:a2564a53230c10b8fe","definition":"A restatement of a text in different words, often to clarify meaning or from memory rather than verbatim.","example":"Near-synonym: paraphrasis","pos":"noun","synonyms":["paraphrasis"],"antonyms":[],"collocations":[],"usage":"","register":"countable, uncountable","wordFamily":["paraphrastic","paraphrastical","paraphrastically"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/paraphrase#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:8db6f3a6b800763ed7","definition":"One of a certain number of Scripture passages turned into verse for use in the service of praise.","example":"","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"Scotland","register":"Scotland, countable, uncountable","wordFamily":["paraphrastic","paraphrastical","paraphrastically"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/paraphrase#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:35e95809218c338a9e","definition":"To restate something as, or to compose a paraphrase. To repeat a written or spoken phrase/quote using different words, often in a simpler and shorter form, or sometimes in a humorous context.","example":"She asked the student to paraphrase the passage.","pos":"verb","synonyms":[],"antonyms":[],"collocations":[],"usage":"ambitransitive","register":"ambitransitive","wordFamily":["paraphrastic","paraphrastical","paraphrastically"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/paraphrase#English","license":"CC-BY-SA-4.0"}],"pronunciation":{"ipa":"/ˈpæɹəfɹeɪz/"},"wordFamily":["paraphrastic","paraphrastical","paraphrastically"]}