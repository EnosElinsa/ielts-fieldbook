{"term":"sufficient","senses":[{"id":"kaikki:4c1259c1594e6db4a6","definition":"An adequate quantity of; enough.","example":"We have sufficient supplies to last the winter.","pos":"det","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":["haplosufficient","immunosufficient","lymphosufficient","omnisufficient","oversufficient","principle of sufficient reason","sufficientarian","sufficient condition","sufficientness","supersufficient"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/sufficient#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:ef6f7118fb9b670a1f","definition":"A quantity (of something) that is as large as is needed.","example":"We don't need any more; we already have sufficient.","pos":"det","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":["haplosufficient","immunosufficient","lymphosufficient","omnisufficient","oversufficient","principle of sufficient reason","sufficientarian","sufficient condition","sufficientness","supersufficient"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/sufficient#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:a07a0c89c404ae52ca","definition":"Of a type or kind that suffices, that satisfies requirements or needs.","example":"This is a necessary condition but not a sufficient one.","pos":"adj","synonyms":[],"antonyms":["insufficient","nonsufficient","unsufficient"],"collocations":[],"usage":"","register":"","wordFamily":["haplosufficient","immunosufficient","lymphosufficient","omnisufficient","oversufficient","principle of sufficient reason","sufficientarian","sufficient condition","sufficientness","supersufficient","law of sufficient reason","sufficient unto the day is the evil thereof","self-sufficient","sufficiency","sufficiently"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/sufficient#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:7df75b67e5b8b672ab","definition":"Possessing adequate talents or accomplishments; of competent power or ability; qualified; fit.","example":"They felt sufficient to maintain their present prosperity and independence.","pos":"adj","synonyms":[],"antonyms":["insufficient","nonsufficient","unsufficient"],"collocations":[],"usage":"","register":"","wordFamily":["haplosufficient","immunosufficient","lymphosufficient","omnisufficient","oversufficient","principle of sufficient reason","sufficientarian","sufficient condition","sufficientness","supersufficient","law of sufficient reason","sufficient unto the day is the evil thereof","self-sufficient","sufficiency","sufficiently"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/sufficient#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:0ae600ec3aa73ed907","definition":"Capable of meeting obligations; responsible.","example":"...to take the best ways we can, to make it known to the Duke of York; for, till Sir J. Minnes be removed, and a sufficient man brought into W. Pen's place, when he is gone, it is impossible for this Office ever to support itself.","pos":"adj","synonyms":[],"antonyms":["insufficient","nonsufficient","unsufficient"],"collocations":[],"usage":"archaic","register":"archaic","wordFamily":["haplosufficient","immunosufficient","lymphosufficient","omnisufficient","oversufficient","principle of sufficient reason","sufficientarian","sufficient condition","sufficientness","supersufficient","law of sufficient reason","sufficient unto the day is the evil thereof","self-sufficient","sufficiency","sufficiently"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/sufficient#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:bf63b0bcd9a851ccf9","definition":"Having enough money to meet obligations and live comfortably.","example":"I shall in this place only mention that qualification by wealth; the rather, being applyed to the deputies of towns and citties, where they use to say of a rich man, he is a very sufficient man : and the other sufficiencies and qualifications are mentioned on other occasions.","pos":"adj","synonyms":[],"antonyms":["insufficient","nonsufficient","unsufficient"],"collocations":[],"usage":"obsolete","register":"obsolete","wordFamily":["haplosufficient","immunosufficient","lymphosufficient","omnisufficient","oversufficient","principle of sufficient reason","sufficientarian","sufficient condition","sufficientness","supersufficient","law of sufficient reason","sufficient unto the day is the evil thereof","self-sufficient","sufficiency","sufficiently"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/sufficient#English","license":"CC-BY-SA-4.0"}],"pronunciation":{"ipa":"/səˈfɪʃənt/","us":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/08/En-us-sufficient.ogg/En-us-sufficient.ogg.mp3"},"wordFamily":["haplosufficient","immunosufficient","lymphosufficient","omnisufficient","oversufficient","principle of sufficient reason","sufficientarian","sufficient condition","sufficientness","supersufficient","law of sufficient reason","sufficient unto the day is the evil thereof","self-sufficient","sufficiency","sufficiently"]}