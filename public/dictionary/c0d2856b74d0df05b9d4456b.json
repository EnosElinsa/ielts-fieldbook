{"term":"field","senses":[{"id":"kaikki:6c73c7a8e18d7be3c5","definition":"A land area free of woodland, cities, and towns; an area of open country.","example":"There are several species of wild flowers growing in this field.","pos":"noun","synonyms":["course","court","ground","pitch","input field","box"],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/field#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:59e8ba6ed4beedab05","definition":"A wide, open space that is used to grow crops or to hold farm animals, usually enclosed by a fence, hedge or other barrier.","example":"There were some cows grazing in a field.","pos":"noun","synonyms":["course","court","ground","pitch","input field","box"],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/field#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:b6ea6400dbb011a6cc","definition":"A region containing a particular mineral.","example":"an oil field; a gold field","pos":"noun","synonyms":["course","court","ground","pitch","input field","box"],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/field#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:fb70786748d3c0c23e","definition":"An airfield, airport or air base; especially, one with unpaved runways.","example":"","pos":"noun","synonyms":["course","court","ground","pitch","input field","box"],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/f