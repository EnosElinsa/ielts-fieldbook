{"term":"exhaust","senses":[{"id":"kaikki:314b2f8da9d96dbd72","definition":"To draw or let out wholly; to drain completely.","example":"The water was exhausted out of the well.","pos":"verb","synonyms":["spend","consume","tire out","weary","tucker"],"antonyms":[],"collocations":[],"usage":"","register":"transitive","wordFamily":["exhausted","exhaustible","exhausting","exhaustion","exhaustive"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/exhaust#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:e2480fd746d071bdf3","definition":"To empty by drawing or letting out the contents.","example":"to exhaust a well","pos":"verb","synonyms":["spend","consume","tire out","weary","tucker"],"antonyms":[],"collocations":[],"usage":"","register":"transitive","wordFamily":["exhausted","exhaustible","exhausting","exhaustion","exhaustive"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/exhaust#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:fce49e6e9e6748894e","definition":"To use up; to deplete, drain or expend wholly, or use until the supply comes to an end.","example":"My grandfather seemingly never exhausts his supply of bad jokes.","pos":"verb","synonyms":["spend","consume","tire out","weary","tucker"],"antonyms":[],"collocations":[],"usage":"figuratively, literally","register":"figuratively, literally, transitive","wordFamily":["exhausted","exhaustible","exhausting","exhaustion","exhaustive"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/exhaust#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:69adc5bae887038afc","definition":"To tire out; to wear out; to cause to be without any energy.","example":"The marathon exhausted me.","pos":"verb","synonyms":["spend","consume","tire out","weary","tucker"],"antonyms":[],