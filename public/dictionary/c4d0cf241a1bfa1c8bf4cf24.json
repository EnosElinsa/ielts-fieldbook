{"term":"require","senses":[{"id":"kaikki:adf2e26204bea60e7e","definition":"To demand, to insist upon (having); to call for authoritatively.","example":"\"I am Miss Newbury,\" I announced, \"and I require to be shown to my room immediately, if you please.\"","pos":"verb","synonyms":["ask","call for","exact"],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":["desperate times require desperate measures","extraordinary claims require extraordinary evidence","prerequire","requirability","requirable","require improvement","unrequire"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/require#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:edd37941df19e9ce7c","definition":"Naturally to demand (something) as indispensable; to need, to call for as necessary.","example":"Chronic pain is occasionally a sign of a very serious problem, like brain tumors, and can require surgery.","pos":"verb","synonyms":["ask","call for","exact"],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":["desperate times require desperate measures","extraordinary claims require extraordinary evidence","prerequire","requirability","requirable","require improvement","unrequire"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/require#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:2f8e149771e667ee3c","definition":"To demand (of someone) to do something.","example":"It is required (of me) that I give evidence in court.","pos":"verb","synonyms":["provide"],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":["desperate times require desperate measures","extraordinary claims require extraordinary evidence","prerequire","requirability","requirable","require improvement","unrequire"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/require#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:589eec4d72aa5bc180","definition":"To ask (someone) for something; to request; to beseech.","example":"I requyre yow lete vs be sworne to gyders that neuer none of vs shalle after this day haue adoo with other, and there with alle syre Tristram and sire Lamorak sware that neuer none of hem shold fyghte ageynst other nor for wele, nor for woo.","pos":"verb","synonyms":["ask","call for","exact"],"antonyms":[],"collocations":[],"usage":"obsolete","register":"obsolete","wordFamily":["desperate times require desperate measures","extraordinary claims require extraordinary evidence","prerequire","requirability","requirable","require improvement","unrequire"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/require#English","license":"CC-BY-SA-4.0"}],"pronunciation":{"ipa":"/ɹɪˈkwaɪə/","us":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/8d/En-us-require.ogg/En-us-require.ogg.mp3"},"wordFamily":["desperate times require desperate measures","extraordinary claims require extraordinary evidence","prerequire","requirability","requirable","require improvement","unrequire"]}