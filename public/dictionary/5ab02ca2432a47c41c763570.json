{"term":"ambition","senses":[{"id":"kaikki:6891c2d49951a8a883","definition":"Eager or inordinate desire for some object that confers distinction, as preferment, honor, superiority, political power, or fame; desire to distinguish one's self from other people.","example":"My daughter, Johanna, wants to be a firefighter very much. She has a lot of ambition.","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"countable, uncountable","wordFamily":["ambitionate","ambitionize","ambitionless","nonambition","overambition","unambition","underambition"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/ambition#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:eeda608d57e828397e","definition":"An object of an ardent desire.","example":"My ambition is to own a helicopter.","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"countable","wordFamily":["ambitionate","ambitionize","ambitionless","nonambition","overambition","unambition","underambition"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/ambition#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:e2ee5c3d5ae77a9e89","definition":"A desire, as in (sense 1), for another person to achieve these things.","example":"","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"countable, uncountable","wordFamily":["ambitionate","ambitionize","ambitionless","nonambition","overambition","unambition","underambition"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/ambition#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:fed3fea9328bcb73df","definition":"A personal quality similar to motivation, not necessarily tied to a single goal.","example":"","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"uncountable","wordFamily":["ambitionate","ambitionize","ambitionless","nonambition","overambition","unambition","underambition"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/ambition#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:97320b1458dacfc10f","definition":"The act of going about to solicit or obtain an office, or any other object of desire; canvassing.","example":"I on th' other ſide / Us'd no ambition to commend my deeds, […]","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"obsolete","register":"countable, obsolete, uncountable","wordFamily":["ambitionate","ambitionize","ambitionless","nonambition","overambition","unambition","underambition"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/ambition#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:34a2b473cf598b814f","definition":"To seek after ambitiously or eagerly; to covet.","example":"Pausanias, ambitioning the sovereignty of Greece, bargains with Xerxes for his daughter in marriage.","pos":"verb","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":["ambitionate","ambitionize","ambitionless","nonambition","overambition","unambition","underambition"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/ambition#English","license":"CC-BY-SA-4.0"}],"pronunciation":{"ipa":"/æmˈbɪʃ.ən/"},"wordFamily":["ambitionate","ambitionize","ambitionless","nonambition","overambition","unambition","underambition"]}