{"term":"upset","senses":[{"id":"kaikki:f17c99f54e99b8979a","definition":"Angry, distressed, or unhappy","example":"He was upset when she refused his friendship.","pos":"adj","synonyms":["sore","unstrung","angry","distressed and unhappy"],"antonyms":[],"collocations":[],"usage":"predicative","register":"predicative","wordFamily":["nonupset","unupset","upsetment","upsetness","upset price","upset stomach","upsetti spaghetti"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/upset#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:55ce696ae24d0db272","definition":"Feeling unwell, nauseated, or ready to vomit.","example":"His stomach was upset, so he didn't want to move.","pos":"adj","synonyms":["in a tizzy"],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":["nonupset","unupset","upsetment","upsetness","upset price","upset stomach","upsetti spaghetti"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/upset#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:ff62359aef0150687d","definition":"Disturbance or disruption.","example":"My late arrival caused the professor considerable upset.","pos":"noun","synonyms":["disruption","disturbance","distraction"],"antonyms":[],"collocations":[],"usage":"","register":"uncountable","wordFamily":["nonupset","unupset","upsetment","upsetness","upset price","upset stomach","upsetti spaghetti","cupset","jet upset","process upset","upset the pot","upsetting thermometer","upset the applecart"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/upset#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:a1b68ac4255a396fd1","definition":"An unexpected victory of a competitor or candidate that was not favored to win.","example":"But it is probably the biggest upset for the away side since Ronnie Radford smashed a famous goal as Hereford defeated Newcastle 2-1 in 1972.","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"countable","wordFamily":["nonupset","unupset","upsetment","upsetness","upset price","upset stomach","upsetti spaghetti","cupset","jet upset","process upset","upset the pot","upsetting thermometer","upset the applecart"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/upset#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:507ad05ba11f233fcc","definition":"An overturn.","example":"\"collision and upset\": impact with another object or an overturn for whatever reason.","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"countable, uncountable","wordFamily":["nonupset","unupset","upsetment","upsetness","upset price","upset stomach","upsetti spaghetti","cupset","jet upset","process upset","upset the pot","upsetting thermometer","upset the applecart"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/upset#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:f91bf457487e18ad0d","definition":"An upset stomach.","example":"“Bob, let's cancel the baby sitter. With this upset stomach, I can't go out tonight.”\n“Sure you can, Liz! Try Pepto-Bismol. Hospital tests prove it relieves upsets. And it's great for indigestion or nausea, too!”","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"countable, uncountable","wordFamily":["nonupset","unupset","upsetment","upsetness","upset price","upset stomach","upsetti spaghetti","cupset","jet upset","process upset","upset the pot","upsetting thermometer","upset the applecart"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/upset#English","license"