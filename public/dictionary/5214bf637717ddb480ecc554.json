{"term":"delegation","senses":[{"id":"kaikki:dcbfba9cbd60793778","definition":"An act of delegating.","example":"Decentralisation of the railways was provided for by the establishment of Area Boards for each Region, which began to function on January 1, 1955, and by the extended delegation of powers to the Boards and their General Managers; […].","pos":"noun","synonyms":["turnover"],"antonyms":[],"collocations":[],"usage":"","register":"countable, uncountable","wordFamily":["delegation language","nondelegation","predelegation","redelegation","subdelegation"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/delegation#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:2bcb5d0390f916c34a","definition":"The condition of being delegated.","example":"","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"countable, uncountable","wordFamily":["delegation language","nondelegation","predelegation","redelegation","subdelegation"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/delegation#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:9522ebcf4a21c0025b","definition":"A group of delegates.","example":"the American delegation","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"countable, uncountable","wordFamily":["delegation language","nondelegation","predelegation","redelegation","subdelegation"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/delegation#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:ecb15f5fa7c2a5e167","definition":"A method-dispatching technique describing the lookup and inheritance rules for self-referential calls.","example":"","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"countable, uncountable","wordFamily":["delegation language","nondelegation","predelegation","redelegation","subdelegation"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/delegation#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:6c94a311660603a067","definition":"The act whereby or constellation in which the performance of an obligation (owed to an obligee, presuming its validity; irrespective of the obligation as the target of the delegation, rarely called delegatary) is assigned by its debtor (delegator, obligor) to and towards another party (delegatee, delegate)","example":"The mere delegation of a performance imposes no duty on the delegate to perform. If the delegate performs the duty, the duty is discharged. If the delegate does not perform the duty, the duty is not discharged, but any claim of the obligee for breach is against the delegating party and not against the delegate.","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"countable, uncountable","wordFamily":["delegation language","nondelegation","predelegation","redelegation","subdelegation"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/delegation#English","license":"CC-BY-SA-4.0"}],"pronunciation":{"ipa":"/dɛlɪˈɡeɪʃən/"},"wordFamily":["delegation language","nondelegation","predelegation","redelegation","subdelegation"]}