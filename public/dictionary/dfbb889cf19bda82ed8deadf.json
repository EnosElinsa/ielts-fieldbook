{"term":"display","senses":[{"id":"kaikki:df6ab255393379f005","definition":"A show or spectacle.","example":"The trapeze artist put on an amazing acrobatic display.","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"countable, uncountable","wordFamily":["characters","CRT","cursor","digits","graphics","monitor","screen","VDU"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/display#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:05254c28a5f7aefcb5","definition":"A piece of work to be presented visually.","example":"Pupils are expected to produce a wall display about a country of their choice.","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"countable, uncountable","wordFamily":["characters","CRT","cursor","digits","graphics","monitor","screen","VDU"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/display#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:b2e64f1d4e831f7d31","definition":"A device, furniture or marketing-oriented bulk packaging for visual presentation for sales promotion.","example":"","pos":"noun","synonyms":["cardboard display"],"antonyms":[],"collocations":[],"usage":"","register":"countable, uncountable","wordFamily":["characters","CRT","cursor","digits","graphics","monitor","screen","VDU"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/display#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:70d5b3d5f00230fa2c","definition":"An electronic screen that shows graphics or text.","example":"","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"countable, uncountable","wordFamily":["characters","CRT","cursor","digits","graphics","monitor","screen","VDU"],"source":"English Wiktionary via Kaikki.o