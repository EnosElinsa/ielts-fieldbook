{"term":"get around","senses":[{"id":"kaikki:a67a3fb1c446aacd49","definition":"To move to the other side of (something, such as an obstruction) by deviating from a direct course or following a curved path.","example":"The tide was too high, and we couldn't get around the rocks.","pos":"verb","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/get_around#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:5a27049424d8897c21","definition":"To avoid or bypass an obstacle.","example":"Tax consultants look for ways to get around the law.","pos":"verb","synonyms":[],"antonyms":[],"collocations":[],"usage":"figuratively","register":"figuratively","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/get_around#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:f1483278df51d4f516","definition":"To circumvent the obligation and performance of a chore; to get out of.","example":"How did you get around having to write the executive report?","pos":"verb","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/get_around#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:e5139e0a6e37e82ff9","definition":"To transport oneself from place to place.","example":"How's he gonna get around without a car?","pos":"verb","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/get_around#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:027bf48726caf2fa18","definition":"To visit numerous different places.","example":"From town to town (get around round round I get around)","pos":"verb","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/get_around#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:6f48ae203856ccb541","definition":"To be sexually promiscuous.","example":"Wow, she really gets around.","pos":"verb","synonyms":[],"antonyms":[],"collocations":[],"usage":"slang","register":"slang","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/get_around#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:80aa2d8db8d77fc7bf","definition":"Used other than figuratively or idiomatically: see get, around.","example":"","pos":"verb","synonyms":["get round","go around"],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/get_around#English","license":"CC-BY-SA-4.0"}],"pronunciation":{"us":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/bf/En-au-get_around.ogg/En-au-get_around.ogg.mp3"},"wordFamily":[]}