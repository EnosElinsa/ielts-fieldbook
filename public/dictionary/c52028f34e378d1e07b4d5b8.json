{"term":"describe","senses":[{"id":"kaikki:d953dfe0286405ad4e","definition":"To represent in words.","example":"The feeling is difficult to describe, but not unpleasant.","pos":"verb","synonyms":["portray","bewrite"],"antonyms":["burlesque","caricature","distort","exaggerate","misrepresent"],"collocations":[],"usage":"","register":"transitive","wordFamily":["abovedescribed","aforedescribed","describability","describee","describer","misdescribe","overdescribe","predescribe","redescribe"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/describe#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:6da19eb5cfd6379a20","definition":"To represent by drawing; to draw a plan of; to delineate; to trace or mark out.","example":"to describe a circle by the compasses; a torch waved about the head in such a way as to describe a circle","pos":"verb","synonyms":["betell","depict","report","delineate","describe","draw","bill","chronicle","explain","narrate","recount","relate","represent","set forth","state"],"antonyms":["burlesque","caricature","distort","exaggerate","misrepresent"],"collocations":[],"usage":"","register":"transitive","wordFamily":["abovedescribed","aforedescribed","describability","describee","describer","misdescribe","overdescribe","predescribe","redescribe"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/describe#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:2b26e5725f3ab10e43","definition":"To give rise to a geometrical structure.","example":"The function describes a very complex surface.","pos":"verb","synonyms":["betell","depict","report","delineate","describe","draw","bill","chronicle","explain","narrate","recount","relate","represent","set forth","state"],"antonyms":["burlesque","caricature","distort","exaggerate","misrepresent"],"collocations":[],"usage":"","register":"transitive",