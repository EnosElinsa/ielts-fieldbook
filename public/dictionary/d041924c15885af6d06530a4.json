{"term":"signal","senses":[{"id":"kaikki:fe1376a98d37980c82","definition":"A sequence of states representing an encoded message in a communication channel.","example":"","pos":"noun","synonyms":[],"antonyms":["noise"],"collocations":[],"usage":"","register":"","wordFamily":["signature","signet","tocsin"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/signal#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:3a7513d922564f70f8","definition":"Any variation of a quantity or change in an entity over time that conveys information upon detection.","example":"","pos":"noun","synonyms":[],"antonyms":["noise"],"collocations":[],"usage":"","register":"","wordFamily":["signature","signet","tocsin"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/signal#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:355cce8e9da8ea10ed","definition":"A sign made to give notice of some occurrence, command, or danger, or to indicate the start of a concerted action.","example":"All obeyed / The wonted signal and superior voice / Of this great potentate.","pos":"noun","synonyms":[],"antonyms":["noise"],"collocations":[],"usage":"","register":"","wordFamily":["signature","signet","tocsin"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/signal#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:27be947ab00d4740f6","definition":"An on-off light, semaphore, or other device used to give an indication to another person.","example":"","pos":"noun","synonyms":[],"antonyms":["noise"],"collocations":[],"usage":"","register":"","wordFamily":["signature","signet","tocsin"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/signal#English","license":"CC-BY-SA-4.0"},{