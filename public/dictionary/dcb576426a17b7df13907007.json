{"term":"effect","senses":[{"id":"kaikki:7df9fe0ca5374e80eb","definition":"The result or outcome of a cause.","example":"The effect of the hurricane was a devastated landscape.","pos":"noun","synonyms":["consequence","basis","cause","genesis","germ","origin","principle","reason","root","source"],"antonyms":["basis","cause","genesis","germ","origin","principle","reason","root","source"],"collocations":[],"usage":"","register":"countable, uncountable","wordFamily":["feckless"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/effect#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:ff1f8762a5fc3beb2d","definition":"Impression left on the mind; sensation produced.","example":"patchwork […] introduced for oratorical effect","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"countable, uncountable","wordFamily":["feckless"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/effect#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:beb6e3b7cc19e6998a","definition":"Execution; performance; realization; operation.","example":"That no compunctious visitings of nature / Shake my fell purpose, nor keep peace between / The effect and it.","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"countable, uncountable","wordFamily":["feckless"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/effect#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:aca12a41599a24d270","definition":"An illusion produced by technical means (as in \"special effect\")","example":"The effect of flying was most convincing.","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"countable, uncountable","wordFamily":["feckless"],"source":"English Wiktionary via Kaikki.o