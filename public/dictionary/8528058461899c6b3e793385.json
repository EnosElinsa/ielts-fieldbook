{"term":"affect","senses":[{"id":"kaikki:2114daefbbfa5151d9","definition":"To influence or alter.","example":"The experience affected me deeply.","pos":"verb","synonyms":["alter","change","have an effect on","influence","play a role in","play a part in"],"antonyms":[],"collocations":[],"usage":"","register":"transitive","wordFamily":["affectability","affectable","affectee","affectingly","affectless","affector","disaffect","interaffect","misaffect","overaffect","reaffect","unaffect"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/affect#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:0ac72ada5dc305d735","definition":"To move to emotion.","example":"He was deeply affected by the tragic ending of the play.","pos":"verb","synonyms":["move","touch"],"antonyms":[],"collocations":[],"usage":"","register":"transitive","wordFamily":["affectability","affectable","affectee","affectingly","affectless","affector","disaffect","interaffect","misaffect","overaffect","reaffect","unaffect"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/affect#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:0db9519546605bdcd4","definition":"Of an illness or condition, to infect or harm (a part of the body).","example":"Hepatitis affects the liver.","pos":"verb","synonyms":["attack","harm","infect"],"antonyms":[],"collocations":[],"usage":"","register":"transitive","wordFamily":["affectability","affectable","affectee","affectingly","affectless","affector","disaffect","interaffect","misaffect","overaffect","reaffect","unaffect"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/affect#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:6552c5f6edcafbcb73","definition":"To dispose or incline.","example":"men whom they thought best affected to