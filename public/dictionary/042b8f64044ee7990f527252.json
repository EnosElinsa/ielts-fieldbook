{"term":"apprentice","senses":[{"id":"kaikki:28c3340c269aed21f7","definition":"A trainee, especially in a skilled trade.","example":"To this end a well-equipped and keenly-run apprentice training school has been in operation at Eastleigh since 1958 and here apprentices are given a good grounding in a number of trades, followed by a thorough training in the trade to which they become allocated.","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":["apprenticehood","apprenticelike","apprenticeship","seaman apprentice","sorcerer's apprentice"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/apprentice#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:e95ec1cca2b5ebcd84","definition":"One who is bound by indentures or by legal agreement to serve a tradesperson, or other person, for a certain time, with a view to learn the art, or trade, in which his master is bound to instruct him.","example":"","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"historical","register":"historical","wordFamily":["apprenticehood","apprenticelike","apprenticeship","seaman apprentice","sorcerer's apprentice"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/apprentice#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:2129837357283ba4c5","definition":"One not well versed in a subject; a tyro or newbie.","example":"","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"dated","register":"dated","wordFamily":["apprenticehood","apprenticelike","apprenticeship","seaman apprentice","sorcerer's apprentice"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/apprentice#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:fbbc268a6478e58f46","definition":"To put under the care and supervision of a master, for the purpose of instruction in a trade or business.","example":"His father had apprenticed him to a silk merchant.","pos":"verb","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"transitive","wordFamily":["apprenticehood","apprenticelike","apprenticeship","seaman apprentice","sorcerer's apprentice"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/apprentice#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:25002c6d3cd92ba887","definition":"To be an apprentice to.","example":"Joe apprenticed three different photographers before setting up his own studio.","pos":"verb","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"transitive","wordFamily":["apprenticehood","apprenticelike","apprenticeship","seaman apprentice","sorcerer's apprentice"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/apprentice#English","license":"CC-BY-SA-4.0"}],"pronunciation":{"ipa":"/əˈpɹɛntɪs/"},"wordFamily":["apprenticehood","apprenticelike","apprenticeship","seaman apprentice","sorcerer's apprentice"]}