nges into a gas easily.","example":"","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":["caustic volatile alkali","involatile","nonvolatile","sal volatile","semivolatile","unvolatile","volatilely","volatile memory","volatileness","volatile organic compound","volatilise","volatility","volatilization","volatilize","volatilizer","volatilome","volatilomic","volatilomics"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/volatile#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:4bca8dd060aae91941","definition":"A variable that is volatile, i.e. has its associated memory immediately updated with any change in value.","example":"Operations on C++ volatiles do put the compiler on notice that the object may be modified asynchronously, and hence are generally safer to use than ordinary variable accesses.","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":["caustic volatile alkali","involatile","nonvolatile","sal volatile","semivolatile","unvolatile","volatilely","volatile memory","volatileness","volatile organic compound","volatilise","volatility","volatilization","volatilize","volatilizer","volatilome","volatilomic","volatilomics"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/volatile#English","license":"CC-BY-SA-4.0"}],"pronunciation":{"ipa":"/ˈvɒl.əˌtaɪl/","uk":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/24/En-uk-volatile.wav/En-uk-volatile.wav.mp3"},"wordFamily":["caustic volatile alkali","involatile","nonvolatile","sal volatile","semivolatile","unvolatile","volatilely","volatile memory","volatileness","volatile organic compound","volatilise","volatility","volatilization","volatilize","volatilizer","volatilome","volatilomic","volatilomics"]}