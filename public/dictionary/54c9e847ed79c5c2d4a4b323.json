{"term":"distinct","senses":[{"id":"kaikki:86b21f6055784775b0","definition":"Capable of being perceived very clearly.","example":"Her voice was distinct despite the heavy traffic.","pos":"adj","synonyms":["clear"],"antonyms":["confusing","indistinct","same","indistinguishable","opaque"],"collocations":[],"usage":"","register":"","wordFamily":["contradistinct","distinctify","distinctly","distinctness","distinctor","distinctual","nondistinct","ultradistinct","undistinct"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/distinct#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:19262fa73cb90effbd","definition":"Different from one another (with the preferable adposition being \"from\").","example":"Horses are distinct from zebras.","pos":"adj","synonyms":["different","separate","several"],"antonyms":["confusing","indistinct","same","indistinguishable","opaque"],"collocations":[],"usage":"","register":"","wordFamily":["contradistinct","distinctify","distinctly","distinctness","distinctor","distinctual","nondistinct","ultradistinct","undistinct"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/distinct#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:03b7da086465d46f43","definition":"Noticeably different from others; distinctive.","example":"Olga's voice is quite distinct because of her accent.","pos":"adj","synonyms":["characteristic","distinctive","prominent"],"antonyms":["confusing","indistinct","same","indistinguishable","opaque"],"collocations":[],"usage":"","register":"","wordFamily":["contradistinct","distinctify","distinctly","distinctness","distinctor","distinctual","nondistinct","ultradistinct","undistinct"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/distinct#English","license":"CC-BY-SA-4.0"},{"