{"term":"vegan","senses":[{"id":"kaikki:577fdec6cc2744ef15","definition":"Not containing animal products (meat, eggs, milk, leather, etc) or inherently involving animal use.","example":"He eats a completely vegan diet.","pos":"adj","synonyms":["plant-based"],"antonyms":[],"collocations":[],"usage":"especially, not-comparable","register":"especially, not-comparable","wordFamily":["antivegan","freegan","nonvegan","pegan","seagan","unvegan","vacon","veganaise","veganarchism","vegan burger","vegangelical","veganhood","veganic","veganify","veganism","veganist","veganite","veganity","veganize","veganlike","veganly","veganness","veganniversary","vegansexual","Veganuary","vegaroni"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/vegan#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:eab6edc5077b6c925f","definition":"Committed to avoiding any product or practice that inherently involves animal use.","example":"She is not vegan as she eats eggs and wears leather.","pos":"adj","synonyms":[],"antonyms":[],"collocations":[],"usage":"not-comparable","register":"not-comparable","wordFamily":["antivegan","freegan","nonvegan","pegan","seagan","unvegan","vacon","veganaise","veganarchism","vegan burger","vegangelical","veganhood","veganic","veganify","veganism","veganist","veganite","veganity","veganize","veganlike","veganly","veganness","veganniversary","vegansexual","Veganuary","vegaroni"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/vegan#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:7e9b35451dfd1eebc9","definition":"Relating to vegans or veganism.","example":"Yesterday I went to a vegan party.","pos":"adj","synonyms":[],"antonyms":[],"collocations":[],"usage":"not-comparable","register":"not-comparable","wordFamily":["antivegan","freegan","nonvegan","pegan","seagan","unvegan","vacon","veganaise","ve