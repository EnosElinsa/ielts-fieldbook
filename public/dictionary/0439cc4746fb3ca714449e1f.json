{"term":"contemplate","senses":[{"id":"kaikki:10077eb7fbf4cbfd61","definition":"To look at on all sides or in all its aspects; to view or consider with continued attention; to regard with deliberate care; to meditate on; to study, ponder, or consider.","example":"To love, at least contemplate and admire, / What I see excellent.","pos":"verb","synonyms":["examine"],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":["contemplatable","contemplate one's navel","contemplatingly","contemplatist","recontemplate","uncontemplated"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/contemplate#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:514efd23539870be61","definition":"To consider as a possibility.","example":"I contemplated doing the project myself, but it would have taken too long.","pos":"verb","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":["contemplatable","contemplate one's navel","contemplatingly","contemplatist","recontemplate","uncontemplated"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/contemplate#English","license":"CC-BY-SA-4.0"}],"pronunciation":{"ipa":"/ˈkɑn.təmˌpleɪt/","us":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/4d/En-us-contemplate.ogg/En-us-contemplate.ogg.mp3"},"wordFamily":["contemplatable","contemplate one's navel","contemplatingly","contemplatist","recontemplate","uncontemplated"]}