{"term":"study","senses":[{"id":"kaikki:e2e3bc7f5c63a41c5f","definition":"To review materials already learned in order to make sure one does not forget them, usually in preparation for an examination.","example":"Students are expected to start studying for final exams in March.","pos":"verb","synonyms":["con","elucubrate","research","revise","sot"],"antonyms":[],"collocations":[],"usage":"literary, usually","register":"intransitive, literary, transitive, usually","wordFamily":["Bible study","forestudy","prestudy","self-study","independent study","nonstudying","outstudy","overstudy","restudy","studiable","study up on"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/study#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:8d56669d0a518e9efb","definition":"To take a course or courses on a subject.","example":"I study medicine at the university.","pos":"verb","synonyms":["con","elucubrate","research","revise","sot"],"antonyms":[],"collocations":[],"usage":"literary","register":"literary, transitive","wordFamily":["Bible study","forestudy","prestudy","self-study","independent study","nonstudying","outstudy","overstudy","restudy","studiable","study up on"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/study#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:697709ccccaf69c187","definition":"To acquire knowledge on a subject with the intention of applying it in practice.","example":"Biologists study living things.","pos":"verb","synonyms":["con","elucubrate","research","revise","sot"],"antonyms":[],"collocations":[],"usage":"","register":"transitive","wordFamily":["Bible study","forestudy","prestudy","self-study","independent study","nonstudying","outstudy","overstudy","restudy","studiable","study up on"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","s