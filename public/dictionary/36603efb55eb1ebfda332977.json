{"term":"swell","senses":[{"id":"kaikki:2e3d57a5e5c14fb777","definition":"To become larger, fuller, or rounder, or expand in size or shape, usually as a result of pressure from within.","example":"My ankles had swelled in the heat.","pos":"verb","synonyms":["balloon"],"antonyms":[],"collocations":[],"usage":"","register":"intransitive","wordFamily":["outswell","overswell","preswell","reswell","swellability","swellable","swellage","swellfish","swellhead","swell hell","swell out","swellshark","swell the ranks","swelltoad","swell up","swelly","unswell"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/swell#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:dbb760daef8918bc9d","definition":"To cause to become bigger.","example":"Rains and dissolving snow swell the rivers in spring.","pos":"verb","synonyms":["distend"],"antonyms":[],"collocations":[],"usage":"","register":"transitive","wordFamily":["outswell","overswell","preswell","reswell","swellability","swellable","swellage","swellfish","swellhead","swell hell","swell out","swellshark","swell the ranks","swelltoad","swell up","swelly","unswell"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/swell#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:fe7d65f2a431585ade","definition":"To grow gradually in force or loudness.","example":"The organ music swelled.","pos":"verb","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"intransitive","wordFamily":["outswell","overswell","preswell","reswell","swellability","swellable","swellage","swellfish","swellhead","swell hell","swell out","swellshark","swell the ranks","swelltoad","swell up","swelly","unswell"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/swell#English","license":"CC-BY-SA-4.0"},{"id