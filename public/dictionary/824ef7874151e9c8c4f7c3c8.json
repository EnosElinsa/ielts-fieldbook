{"term":"rescue","senses":[{"id":"kaikki:cd1dbdc32fb76fde93","definition":"To save from any violence, danger or evil.","example":"The well-trained team rescued everyone after the avalanche.","pos":"verb","synonyms":["free","deliver","pull out of the fire"],"antonyms":["endanger","imperil"],"collocations":[],"usage":"","register":"transitive","wordFamily":["rescuable","rescuee","rescuer","unrescued"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/rescue#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:747a5b35dec2740378","definition":"To free or liberate from confinement or other physical restraint.","example":"to rescue a prisoner from the enemy","pos":"verb","synonyms":["liberate","release"],"antonyms":["arrest","capture","kidnap"],"collocations":[],"usage":"","register":"transitive","wordFamily":["rescuable","rescuee","rescuer","unrescued"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/rescue#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:58c4ebd14eebfbd980","definition":"To recover forcibly, especially from a siege.","example":"","pos":"verb","synonyms":["liberate","recapture","retake"],"antonyms":["besiege","capture"],"collocations":[],"usage":"","register":"transitive","wordFamily":["rescuable","rescuee","rescuer","unrescued"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/rescue#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:8e39bfd7ea6b9590ff","definition":"To remove or withdraw from a state of exposure to evil and sin.","example":"Traditionally missionaries aim to rescue many ignorant heathen souls.","pos":"verb","synonyms":["redeem","save"],"antonyms":["corrupt","deprave"],"collocations":[],"usage":"figuratively","register":"figuratively, transitive","wordFamily":["rescuable","rescuee","