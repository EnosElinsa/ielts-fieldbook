{"term":"flare","senses":[{"id":"kaikki:e804091a21c55b43ac","definition":"A sudden bright light.","example":"","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":["airflare","autoflare","earflare","flare angel","flareback","flare gun","flareless","flare nut","flare nut wrench","flare path","flarepath","flare stack","flare tower","flary","hyperflare","postflare","preflare","tripflare","trip flare","unflare","outflare","upflare"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/flare#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:e58ccc030f0d79be65","definition":"A source of brightly burning light or intense heat.","example":"solar flare","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":["airflare","autoflare","earflare","flare angel","flareback","flare gun","flareless","flare nut","flare nut wrench","flare path","flarepath","flare stack","flare tower","flary","hyperflare","postflare","preflare","tripflare","trip flare","unflare","outflare","upflare"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/flare#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:61921202e677ddb2ca","definition":"A sudden eruption or outbreak; a flare-up.","example":"\"A strange flare of maternal pride,\" he remarked in his usual detached fashion as he rejoined Parkinson.","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"figuratively","register":"figuratively","wordFamily":["airflare","autoflare","earflare","flare angel","flareback","flare gun","flareless","flare nut","flare nut wrench","flare path","flarepath","flare stack","flare tower","flary","hyperflare","postflare","preflare","tripflare","trip flare","unflare","outflare","upflare"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wikt