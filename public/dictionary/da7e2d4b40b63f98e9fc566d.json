Url":"https://en.wiktionary.org/wiki/appeal#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:58165a38c7e5101fae","definition":"At common law, an accusation made against a felon by one of their accomplices (called an approver).","example":"","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"historical","register":"countable, historical, uncountable","wordFamily":["appeal court","appeals court","appeal to authority","appeal to emotion","appeal to motive","appeal to nature","counterappeal","court of appeal","curb appeal","sex appeal","street appeal","whip appeal","cross-appeal"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/appeal#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:cbfb316b25bfea6af9","definition":"A call to a person or an authority for a decision, help, or proof; an entreaty, an invocation.","example":"He made an appeal for volunteers to help at the festival.","pos":"noun","synonyms":["cri de coeur"],"antonyms":[],"collocations":[],"usage":"","register":"countable, uncountable","wordFamily":["appeal court","appeals court","appeal to authority","appeal to emotion","appeal to motive","appeal to nature","counterappeal","court of appeal","curb appeal","sex appeal","street appeal","whip appeal","cross-appeal"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/appeal#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:7a91f7515425173cf6","definition":"A resort to some physical means; a recourse.","example":"","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"figuratively","register":"countable, figuratively, uncountable","wordFamily":["appeal court","appeals court","appeal to authority","appeal to emotion","appeal to motive","appeal to nature","counterappeal","court of appeal","curb appeal","sex appeal","street appeal","whip appeal","cross-appeal"],"sou