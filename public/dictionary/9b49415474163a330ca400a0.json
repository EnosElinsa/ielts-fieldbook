{"term":"contradict","senses":[{"id":"kaikki:c66985a1972ad075e5","definition":"To deny the truth or validity of (a statement or statements).","example":"His testimony contradicts hers.","pos":"verb","synonyms":["contravene","disconfirm","deny","dispute","question","gainsay","refute","controvert","withspeak"],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":["contradick","contradictable","contradicter","contradictive","self-contradict"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/contradict#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:20682836f488707d7c","definition":"To oppose (a person) by denying the truth or pertinence of a given statement.","example":"Everything he says contradicts me.","pos":"verb","synonyms":["contravene","disconfirm","deny","dispute","question","gainsay","refute","controvert","withspeak"],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":["contradick","contradictable","contradicter","contradictive","self-contradict"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/contradict#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:8aca98fe2dc0d1d549","definition":"To be contrary to (something).","example":"Now no truth can contradict any truth; desirous therefore they were to be taught, how bothe might stand together, that which they knew could not be false, because Christ spake it; and this which to them did seeme true, onely because the Scribes had said it.","pos":"verb","synonyms":["contravene","disconfirm","deny","dispute","question","gainsay","refute","controvert","withspeak"],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":["contradick","contradictable","contradicter","contradictive","self-contradict"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/contradict#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:7b4dbc80922a984151","definition":"To say things that conflict with each other.","example":"The prime minister contradicted herself during her speech.","pos":"verb","synonyms":["contravene","disconfirm","deny","dispute","question","gainsay","refute","controvert","withspeak"],"antonyms":[],"collocations":[],"usage":"reflexive","register":"reflexive","wordFamily":["contradick","contradictable","contradicter","contradictive","self-contradict"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/contradict#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:c6f2445bfb9070b931","definition":"To give an order contrary to (another order or wish), oppose (something).","example":"[…] when was the hour\nI ever contradicted your desire,\nOr made it not mine too?","pos":"verb","synonyms":["contravene","disconfirm","deny","dispute","question","gainsay","refute","controvert","withspeak"],"antonyms":[],"collocations":[],"usage":"obsolete","register":"obsolete","wordFamily":["contradick","contradictable","contradicter","contradictive","self-contradict"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/contradict#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:77e612f204ce616b1e","definition":"To give an order contrary to one given by (another person), oppose or resist (someone).","example":"Beseemes it thee to contradict thy king? […]\nI will haue Gaueston, and you shall know,\nWhat danger tis to stand against your king.","pos":"verb","synonyms":["contravene","disconfirm","deny","dispute","question","gainsay","refute","controvert","withspeak"],"antonyms":[],"collocations":[],"usage":"obsolete","register":"obsolete","wordFamily":["contradick","contradictable","contradicter","contradictive","self-contradict"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/contradict#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:ae19fd9e5e9e289706","definition":"To speak against; to forbid.","example":"[…] magic hath been publicly professed in former times, in Salamanca, Cracovia, and other places, though after censured by several universities, and now generally contradicted, though practised by some still […].","pos":"verb","synonyms":["contravene","disconfirm","deny","dispute","question","gainsay","refute","controvert","withspeak"],"antonyms":[],"collocations":[],"usage":"obsolete","register":"obsolete","wordFamily":["contradick","contradictable","contradicter","contradictive","self-contradict"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/contradict#English","license":"CC-BY-SA-4.0"}],"pronunciation":{"ipa":"/ˌkɒn.tɹəˈdɪkt/"},"wordFamily":["contradick","contradictable","contradicter","contradictive","self-contradict"]}