{"term":"duplicate","senses":[{"id":"kaikki:26ff75394f2de1f19b","definition":"Being the same as another; identical, often having been copied from an original.","example":"This is a duplicate entry.","pos":"adj","synonyms":[],"antonyms":[],"collocations":[],"usage":"not-comparable","register":"not-comparable","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/duplicate#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:73746218d58593b2f6","definition":"In which the hands of cards, tiles, etc. are preserved between rounds to be played again by other players.","example":"duplicate whist","pos":"adj","synonyms":[],"antonyms":[],"collocations":[],"usage":"not-comparable","register":"not-comparable","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/duplicate#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:f73706edf2c117ae03","definition":"To make a copy of.","example":"If we duplicate the information, are we really accomplishing much?","pos":"verb","synonyms":["double"],"antonyms":["dedupe","deduplicate"],"collocations":[],"usage":"","register":"transitive","wordFamily":["repeat"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/duplicate#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:1d753b1627fc94c217","definition":"To do repeatedly; to do again.","example":"You don't need to duplicate my efforts.","pos":"verb","synonyms":["dupe","duplicate","facsimilize"],"antonyms":["dedupe","deduplicate"],"collocations":[],"usage":"","register":"transitive","wordFamily":["repeat"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/duplicate#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:b1c5976e9b58dd0de5","d