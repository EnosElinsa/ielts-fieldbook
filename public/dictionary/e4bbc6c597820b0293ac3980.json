{"term":"interpret","senses":[{"id":"kaikki:bd44b3627fce3c90e9","definition":"To decode the meaning of a topic and then act, whether to continue researching the topic, follow through, act in opposition, or further the understanding through sharing an interpretation.","example":"","pos":"verb","synonyms":["take","understand","construe"],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":["interpretory","overinterpret","preinterpret"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/interpret#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:d1b4aa78649bddaeb1","definition":"To explain or tell the meaning of; to translate orally into intelligible or familiar language or terms. applied especially to language, but also to dreams, signs, conduct, mysteries, etc.","example":"to interpret an Indian speech","pos":"verb","synonyms":["translate","explain","construe","solve","render","expound","elucidate","decipher","unfold","unravel"],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":["interpretory","overinterpret","preinterpret"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/interpret#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:17bbda63a3a570d478","definition":"To apprehend and represent by means of art; to show by illustrative representation.","example":"The actor interpreted the character of Hamlet with great skill.","pos":"verb","synonyms":["translate","explain","construe","solve","render","expound","elucidate","decipher","unfold","unravel"],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":["interpretory","overinterpret","preinterpret"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/interpret#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:8f668311090b2df506","definition":"To convey what a user of one language is saying or signing, in real time or shortly after that person has finished communicating, to a user of a different language.","example":"He interpreted at the meeting between the Chinese and French associates.","pos":"verb","synonyms":["translate","explain","construe","solve","render","expound","elucidate","decipher","unfold","unravel"],"antonyms":[],"collocations":[],"usage":"","register":"intransitive","wordFamily":["interpretory","overinterpret","preinterpret"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/interpret#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:71802e299c21f6bdfd","definition":"To analyse or execute (a program) by reading the instructions as they are encountered, rather than compiling in advance.","example":"","pos":"verb","synonyms":["translate","explain","construe","solve","render","expound","elucidate","decipher","unfold","unravel"],"antonyms":[],"collocations":[],"usage":"","register":"transitive","wordFamily":["interpretory","overinterpret","preinterpret"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/interpret#English","license":"CC-BY-SA-4.0"}],"pronunciation":{"ipa":"/ɪnˈtɜː.pɹɪt/"},"wordFamily":["interpretory","overinterpret","preinterpret"]}