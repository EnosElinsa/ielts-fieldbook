{"term":"turmoil","senses":[{"id":"kaikki:ad37ff1df3a9a05f79","definition":"A state of great disorder or uncertainty.","example":"Oleg Blokhin's side lost the talismanic Andriy Shevchenko to the substitutes' bench because of a knee injury but still showed enough to put England through real turmoil in spells.","pos":"noun","synonyms":["chaos","disorder"],"antonyms":[],"collocations":[],"usage":"usually","register":"uncountable, usually","wordFamily":["turmoiler"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/turmoil#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:18360bdb5f714ffca7","definition":"Harassing labor; trouble; disturbance.","example":"And there I'll rest, as after much turmoil, / A blessed soul doth in Elysium.","pos":"noun","synonyms":["chaos","disorder"],"antonyms":[],"collocations":[],"usage":"usually","register":"uncountable, usually","wordFamily":["turmoiler"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/turmoil#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:5846004b12d657a1f5","definition":"To be disquieted or confused; to be in commotion.","example":"some notable sophister lies sweating and turmoiling under the inevitable and merciless delimmas of Socrates","pos":"verb","synonyms":[],"antonyms":[],"collocations":[],"usage":"obsolete","register":"intransitive, obsolete","wordFamily":["turmoiler"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/turmoil#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:f8842a3b5a27724b8f","definition":"To harass with commotion; to disquiet; to worry.","example":"It is her fatal misfortune […] to be thus miserably tossed and turmoiled with these storms of affliction.","pos":"verb","synonyms":[],"antonyms":[],"collocations":[],"usage":"obsolete","register":"obsolete, transitive","wordFamily":["turmoiler"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/turmoil#English","license":"CC-BY-SA-4.0"}],"pronunciation":{"ipa":"/ˈtɜːmɔɪl/","us":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/fc/En-us-turmoil.ogg/En-us-turmoil.ogg.mp3"},"wordFamily":["turmoiler"]}