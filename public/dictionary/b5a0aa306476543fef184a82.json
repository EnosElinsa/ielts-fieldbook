"],"antonyms":["impossibility","sure thing"],"collocations":[],"usage":"","register":"countable, uncountable","wordFamily":["logical possibility","nonpossibility","possibility of reverter","possibility theory","production possibility curve","unpossibility"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/possibility#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:8d4c8b06c138e40069","definition":"Capability, power or capacity to act.","example":"VVere Iacke Strawe a liue againe,\nAnd I in as good poſſibility as euer I was,\nI would lay a ſurer trumpe,\nEre I would loſe ſo faire a tricke.","pos":"noun","synonyms":["chance","contingency","contingent","eventuality","possibility","potentiality"],"antonyms":["impossibility","sure thing"],"collocations":[],"usage":"obsolete","register":"countable, obsolete, uncountable","wordFamily":["logical possibility","nonpossibility","possibility of reverter","possibility theory","production possibility curve","unpossibility"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/possibility#English","license":"CC-BY-SA-4.0"}],"pronunciation":{"ipa":"/ˌpɒs.ɪˈbɪl.ɪ.ti/","us":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/b3/En-us-possibility.ogg/En-us-possibility.ogg.mp3"},"wordFamily":["logical possibility","nonpossibility","possibility of reverter","possibility theory","production possibility curve","unpossibility"]}