{"term":"notice","senses":[{"id":"kaikki:35f36a4db65f1d06b1","definition":"The act of observing; perception.","example":"He took no notice of the changes, and went on as though nothing had happened.","pos":"noun","synonyms":["regard"],"antonyms":[],"collocations":[],"usage":"","register":"uncountable","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/notice#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:ba95c00c349d87f419","definition":"A written or printed announcement.","example":"A series of notices signpost patients to the X-ray department.","pos":"noun","synonyms":["regard"],"antonyms":[],"collocations":[],"usage":"","register":"countable","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/notice#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:45028ae34dc9b0ce99","definition":"A formal notification or warning.","example":"The sidewalk adjacent to the damaged bridge stonework shall be closed until further notice.","pos":"noun","synonyms":["regard"],"antonyms":[],"collocations":[],"usage":"","register":"countable","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/notice#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:7ba015345d3eee40fb","definition":"Advance notification of termination of employment, given by an employer to an employee or vice versa.","example":"I gave her her mandatory two weeks' notice and sacked her.","pos":"noun","synonyms":["regard"],"antonyms":[],"collocations":[],"usage":"","register":"uncountable","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/notice#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:cbab6efd7d1df4a5bf","definitio