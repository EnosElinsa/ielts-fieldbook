{"term":"out of date","senses":[{"id":"kaikki:01cfa2c95d981f6a15","definition":"Too old to be used; not current; invalid; having expired.","example":"My bus pass is out of date — I'll have to go buy a new one.","pos":"prep_phrase","synonyms":["antiquated"],"antonyms":["up to date","in date"],"collocations":[],"usage":"idiomatic","register":"idiomatic","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/out_of_date#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:5a18cb2acd1648ff07","definition":"Not conforming to the current fashion or style; old-fashioned; outmoded.","example":"The dresses she wears are quite out of date.","pos":"prep_phrase","synonyms":["archaic","old-fashioned","outdated","parachronistic","unhip","démodé"],"antonyms":["up to date","in date"],"collocations":[],"usage":"idiomatic","register":"idiomatic","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/out_of_date#English","license":"CC-BY-SA-4.0"}],"pronunciation":{"us":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/0e/En-au-out_of_date.ogg/En-au-out_of_date.ogg.mp3"},"wordFamily":[]}