{"term":"statistics","senses":[{"id":"kaikki:9f08f86b9d9bf9c46f","definition":"A discipline, principally within applied mathematics, concerned with the systematic study of the collection, presentation, analysis, and interpretation of data.","example":"Statistics is the only mathematical field required for many social sciences.","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"uncountable","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/statistics#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:6d3384e3434298bb86","definition":"A systematic collection of data on measurements or observations, often related to demographic information such as population counts, incomes, population counts at different ages, etc.","example":"The statistics from the Census for apportionment are available.","pos":"noun","synonyms":["stats"],"antonyms":[],"collocations":[],"usage":"plural, plural-only","register":"plural, plural-only","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/statistics#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:ac5ee5dc55923cf192","definition":"plural of statistic","example":"","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"form-of, plural","register":"form-of, plural","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/statistics#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:8ad8ab46a0f0ba96e9","definition":"third-person singular simple present indicative of statistic","example":"","pos":"verb","synonyms":[],"antonyms":[],"collocations":[],"usage":"form-of, indicative, present, singular, third-person","register":"form-of, indicative, present, singular, third-person","wordFamily":[],"source":"English