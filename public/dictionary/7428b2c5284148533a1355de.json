{"term":"sigh","senses":[{"id":"kaikki:9160f9e6ff153441eb","definition":"To inhale a larger quantity of air than usual, and immediately expel it; to make a deep single audible respiration, especially as the result or involuntary expression of fatigue, exhaustion, grief, sorrow, frustration, or the like.","example":"When she saw it wasn't damaged, she sighed with relief.","pos":"verb","synonyms":["suspire","sithe"],"antonyms":[],"collocations":[],"usage":"","register":"intransitive","wordFamily":["besigh","outsigh","sigher"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/sigh#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:bd93045ee0f862c5a0","definition":"To lament; to grieve.","example":"He sighed deeply in his spirit.","pos":"verb","synonyms":["sithe","yearn","aggrieve","besorrow","condole","darken","engrieve","erme","gloom","grieve","grieven","bleed","lament","moan","mourn","remorse","repent","regret","rue","sigh","sorrow","wayment","yearn"],"antonyms":[],"collocations":[],"usage":"","register":"intransitive","wordFamily":["besigh","outsigh","sigher"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/sigh#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:98768851795b9fd59f","definition":"To utter sighs over; to lament or mourn over.","example":"Ages to come, and men unborn, / Shall bless her name, and sigh her fate.","pos":"verb","synonyms":["grieve","lament","sithe","afterthink","becry","begrieve","bemoan","bemourn","bewail","beweep","condole","deplore","elegize","grieve","grieven","keen","lament","mean","mourn","pine","repent","sigh","sorrow","wail","wayment"],"antonyms":[],"collocations":[],"usage":"","register":"transitive","wordFamily":["besigh","outsigh","sigher"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/sigh#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:4b950fb3970b140621","definition":"To make a sound like sighing.","example":"The wind sighed in the trees.","pos":"verb","synonyms":["sithe"],"antonyms":[],"collocations":[],"usage":"","register":"intransitive","wordFamily":["besigh","outsigh","sigher"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/sigh#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:2830d5bb4e2686281c","definition":"To exhale (the breath) in sighs.","example":"She sighed a sigh that was nearly a groan.","pos":"verb","synonyms":["sithe"],"antonyms":[],"collocations":[],"usage":"","register":"transitive","wordFamily":["besigh","outsigh","sigher"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/sigh#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:ba40ed7dc4ed2c463b","definition":"To express by sighs; to utter in or with sighs.","example":"\"I guess I have no choice,\" she sighed.","pos":"verb","synonyms":["sithe"],"antonyms":[],"collocations":[],"usage":"","register":"transitive","wordFamily":["besigh","outsigh","sigher"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/sigh#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:b6fd36f82ebfba708c","definition":"A deep, prolonged audible inhale and exhale of breath; as when fatigued, frustrated, grieved, or relieved; the act of sighing.","example":"To Pollyanna the air was all the more stifling after that cool breath of the out of doors; but she did not complain. She only drew a long quivering sigh.","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":["besigh","outsigh","sigher","le sigh","sighful","sighless","sighlike","sigh of relief","yawn-sigh"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/sigh#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:9cf11b6006c86e42b6","definition":"a manifestation of grief; a lament.","example":"","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"figuratively","register":"figuratively","wordFamily":["besigh","outsigh","sigher","le sigh","sighful","sighless","sighlike","sigh of relief","yawn-sigh"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/sigh#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:d3772ae2b496af7c6f","definition":"A person who is bored.","example":"","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"Cockney, slang","register":"Cockney, slang","wordFamily":["besigh","outsigh","sigher","le sigh","sighful","sighless","sighlike","sigh of relief","yawn-sigh"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/sigh#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:032086c63c6dd75aaf","definition":"An expression of fatigue, exhaustion, grief, sorrow, frustration, or the like, often used in casual written contexts.","example":"Sigh, I'm so bored at work today.","pos":"intj","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":["besigh","outsigh","sigher","le sigh","sighful","sighless","sighlike","sigh of relief","yawn-sigh"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/sigh#English","license":"CC-BY-SA-4.0"}],"pronunciation":{"ipa":"/saɪ/","us":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/62/En-us-sigh.ogg/En-us-sigh.ogg.mp3"},"wordFamily":["besigh","outsigh","sigher","le sigh","sighful","sighless","sighlike","sigh of relief","yawn-sigh"]}