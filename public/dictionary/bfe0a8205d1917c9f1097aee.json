{"term":"aspire","senses":[{"id":"kaikki:763350b112dd973703","definition":"To have a strong desire or ambition to achieve something.","example":"to aspire to / for / after / to do something; to aspire that something happens","pos":"verb","synonyms":["crave","pursue","strive","yearn","dream"],"antonyms":[],"collocations":[],"usage":"","register":"intransitive","wordFamily":["aspiratory","aspirement","reaspire"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/aspire#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:61125c1de59a04ec27","definition":"To go as high as, to reach the top of (something).","example":"Thus ſhall my heart be ſtil combinde with thine, / Untill our bodies turne to Elements: / And both our ſoules aſpire celeſtiall thrones.","pos":"verb","synonyms":["ascend","mount"],"antonyms":[],"collocations":[],"usage":"obsolete","register":"obsolete, transitive","wordFamily":["aspiratory","aspirement","reaspire"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/aspire#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:d52ecad3577168d099","definition":"To move upward; to be very tall.","example":"In midſt of which a ſumptuous Temple ſtands, / That threats the ſtarres with her aſpiring toppe.","pos":"verb","synonyms":["ascend","rise","soar","tower"],"antonyms":[],"collocations":[],"usage":"archaic, literary","register":"archaic, intransitive, literary, transitive","wordFamily":["aspiratory","aspirement","reaspire"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/aspire#English","license":"CC-BY-SA-4.0"}],"pronunciation":{"ipa":"/əˈspaɪə(ɹ)/","us":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/78/En-us-aspire.ogg/En-us-aspire.ogg.mp3"},"wordFamily":["aspiratory","aspirement","reaspire"]}