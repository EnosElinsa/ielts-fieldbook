{"term":"proceed","senses":[{"id":"kaikki:88bbba91115a5aedf2","definition":"To move, pass, or go forward or onward; to advance; to carry on.","example":"to proceed on a journey","pos":"verb","synonyms":["progress","forthgo","carry on","continue","go on","keep on","proceed","roll on","hunker down"],"antonyms":["regress","recede","desist","end","stop"],"collocations":[],"usage":"","register":"intransitive","wordFamily":["proceedable","proceeder"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/proceed#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:927d81139938653021","definition":"To pass from one point, topic, or stage, to another.","example":"to proceed with a story or argument","pos":"verb","synonyms":["progress","forthgo","carry on","continue","go on","keep on","proceed","roll on","hunker down"],"antonyms":["regress","recede","desist","end","stop"],"collocations":[],"usage":"","register":"intransitive","wordFamily":["proceedable","proceeder"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/proceed#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:15c8a4ce32bcdffb4e","definition":"To come from; to have as its source or origin.","example":"Light proceeds from the sun.","pos":"verb","synonyms":["progress","forthgo","carry on","continue","go on","keep on","proceed","roll on","hunker down"],"antonyms":["regress","recede","desist","end","stop"],"collocations":[],"usage":"","register":"intransitive","wordFamily":["proceedable","proceeder"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/proceed#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:856762e7153828abb2","definition":"To go on in an orderly or regulated manner; to begin and carry on a series of acts or measures; to act methodically.","example":"He that proceeds upon others Principles in his Enquiry into any Sciences, though he be reſolv’d to examine them and judge of them freely, does yet at leaſt put himſelf on that ſide, and poſt himſelf in a Party which he will not quit ’till he be beaten out; […]","pos":"verb","synonyms":["progress","forthgo","carry on","continue","go on","keep on","proceed","roll on","hunker down"],"antonyms":["regress","recede","desist","end","stop"],"collocations":[],"usage":"","register":"intransitive","wordFamily":["proceedable","proceeder"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/proceed#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:e66cb9d5a8749cc125","definition":"To be transacted; to take place; to occur.","example":"And he will (after his ſowre faſhion) tell you\nWhat hath proceeded worthy note to day.","pos":"verb","synonyms":["progress","forthgo","carry on","continue","go on","keep on","proceed","roll on","hunker down"],"antonyms":["regress","recede","desist","end","stop"],"collocations":[],"usage":"","register":"intransitive","wordFamily":["proceedable","proceeder"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/proceed#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:1d33c28832717aa0d6","definition":"To be applicable or effective; to be valid.","example":"For it [this rule] only proceeds and takes place, when a Perſon cannot of common Right condemn or bind another by his Sentence; […]","pos":"verb","synonyms":["progress","forthgo","carry on","continue","go on","keep on","proceed","roll on","hunker down"],"antonyms":["regress","recede","desist","end","stop"],"collocations":[],"usage":"","register":"intransitive","wordFamily":["proceedable","proceeder"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/proceed#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:cfd85756f709c57327","definition":"To begin and carry on a legal process.","example":"“Gentlemen, shall we proceed?” the judge said.\nFrom the beginning, Judge Fong appeared bored at Levine's coaxing remarks.","pos":"verb","synonyms":["progress","forthgo","carry on","continue","go on","keep on","proceed","roll on","hunker down"],"antonyms":["regress","recede","desist","end","stop"],"collocations":[],"usage":"","register":"intransitive","wordFamily":["proceedable","proceeder"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/proceed#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:58a10a9e444609d1e7","definition":"To take an academic degree.","example":"","pos":"verb","synonyms":["progress","forthgo","carry on","continue","go on","keep on","proceed","roll on","hunker down"],"antonyms":["regress","recede","desist","end","stop"],"collocations":[],"usage":"","register":"intransitive","wordFamily":["proceedable","proceeder"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/proceed#English","license":"CC-BY-SA-4.0"}],"pronunciation":{"ipa":"/pɹəˈsiːd/","us":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/2d/En-us-proceed.ogg/En-us-proceed.ogg.mp3"},"wordFamily":["proceedable","proceeder"]}