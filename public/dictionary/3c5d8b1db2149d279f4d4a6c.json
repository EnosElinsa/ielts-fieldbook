{"term":"mutter","senses":[{"id":"kaikki:3f89eb03671c14cb65","definition":"A repressed or obscure utterance; an instance of muttering.","example":"The prisoners were docile, and accepted their lot with barely a mutter.","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/mutter#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:78dc954a2abf9efea0","definition":"To utter words, especially complaints or angry expressions, indistinctly or with a low voice and lips partly closed; to say under one's breath.","example":"You could hear the students mutter as they were served sodden spaghetti, yet again, in the cafeteria.","pos":"verb","synonyms":["growl","grumble","mumble"],"antonyms":[],"collocations":[],"usage":"","register":"intransitive, transitive","wordFamily":["amutter","mutterance","mutteration","mutterer","mutteringly","muttersome","muttery","unmuttered"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/mutter#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:c695ad7c8e3fcf7e00","definition":"To speak softly and incoherently, or with imperfect articulations.","example":"The asylum inmate muttered some doggerel about chains and pains to himself, over and over.","pos":"verb","synonyms":["babble","mumble","murmur","ramble","stutter"],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":["amutter","mutterance","mutteration","mutterer","mutteringly","muttersome","muttery","unmuttered"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/mutter#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:23cae79384a626f490","definition":"To make a sound with a low, rumbling noise.","example":"April could hear the delivery van's engine muttering in the driveway.","pos":"verb","synonyms":["growl","putter","rumble"],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":["amutter","mutterance","mutteration","mutterer","mutteringly","muttersome","muttery","unmuttered"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/mutter#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:321fc0f9db58b4b235","definition":"Peas.","example":"","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":["amutter","mutterance","mutteration","mutterer","mutteringly","muttersome","muttery","unmuttered"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/mutter#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:6e05dbd8a119637524","definition":"A surname.","example":"","pos":"name","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":["amutter","mutterance","mutteration","mutterer","mutteringly","muttersome","muttery","unmuttered"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/Mutter#English","license":"CC-BY-SA-4.0"}],"pronunciation":{"ipa":"/ˈmʌtə/"},"wordFamily":["amutter","mutterance","mutteration","mutterer","mutteringly","muttersome","muttery","unmuttered"]}