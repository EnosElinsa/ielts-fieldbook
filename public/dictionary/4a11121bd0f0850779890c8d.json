{"term":"surcharge","senses":[{"id":"kaikki:70fd654639568c98ea","definition":"An addition of extra charge on the agreed, stated, or baseline price. Sometimes portrayed by a buyer as excessive and rapacious; usually portrayed by a seller as justified and necessary.","example":"Our airline tickets cost twenty dollars more than we expected because we had to pay a fuel surcharge.","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":["victim surcharge"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/surcharge#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:10e17759bf9a7464e1","definition":"The part of the price of a subsidized good or service that is not covered by the subsidy and so must be paid by the consumer.","example":"","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":["victim surcharge"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/surcharge#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:a7a2b2ef98bb2d4bb8","definition":"An overprint on a stamp that alters (usually raises) the original nominal value of the stamp; used especially in times of hyperinflation.","example":"","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":["victim surcharge"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/surcharge#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:7740b0dc65302a8013","definition":"A painting in lighter enamel over a darker one that serves as the ground.","example":"","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":["victim surcharge"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/surcharge#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:3ff6af134b3e478c73","definition":"A charge that has been omitted from an account as payment of a credit to the charged party","example":"","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":["victim surcharge"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/surcharge#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:a89765483cdc67f26d","definition":"A penalty for failure to exercise common prudence and skill in the performance of a fiduciary's duties.","example":"","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":["victim surcharge"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/surcharge#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:23a4a4a4878d27235f","definition":"An excessive load or burden.","example":"A Numerous Nobility, cauſet Pouerty, and Inconuenience in a State: For it is a Surcharge of Expence;","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"obsolete","register":"obsolete","wordFamily":["victim surcharge"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/surcharge#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:804677c28cb4ae93d0","definition":"The putting, by a commoner, of more animals on the common than he is entitled to.","example":"","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"obsolete","register":"obsolete","wordFamily":["victim surcharge"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/surcharge#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:d73e944207945f9b7b","definition":"To apply a surcharge.","example":"","pos":"verb","synonyms":[],"antonyms":["discount"],"collocations":[],"usage":"","register":"","wordFamily":["victim surcharge","surchargeable","surchargement"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/surcharge#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:0a5303db0a0644e26e","definition":"To overload; to overburden.","example":"to surcharge an animal or a ship; to surcharge a cannon","pos":"verb","synonyms":[],"antonyms":["discount"],"collocations":[],"usage":"","register":"","wordFamily":["victim surcharge","surchargeable","surchargement"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/surcharge#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:8dc065bdafb341448b","definition":"To overstock; especially, to put more cattle into (e.g. a common) than one has a right to do, or more than the herbage will sustain.","example":"Another diſturbance of common is by ſurcharging it; or putting more cattle therein than the paſture and herbage will ſuſtain, or the party hath a right to do.","pos":"verb","synonyms":[],"antonyms":["discount"],"collocations":[],"usage":"","register":"","wordFamily":["victim surcharge","surchargeable","surchargement"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/surcharge#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:84ee8739278b19e78a","definition":"To show an omission in (an account) for which credit ought to have been given.","example":"The Idle multitude surcharge their laies","pos":"verb","synonyms":[],"antonyms":["discount"],"collocations":[],"usage":"","register":"","wordFamily":["victim surcharge","surchargeable","surchargement"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/surcharge#English","license":"CC-BY-SA-4.0"}],"pronunciation":{"ipa":"/ˈsɜːt͡ʃɑːd͡ʒ/","us":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/d2/En-us-surcharge.ogg/En-us-surcharge.ogg.mp3"},"wordFamily":["victim surcharge","surchargeable","surchargement"]}