{"term":"dusk","senses":[{"id":"kaikki:92023ff9fbaedabc04","definition":"Tending to darkness or blackness; moderately dark or black; dusky.","example":"A pathless desert, dusk with horrid shades.","pos":"adj","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/dusk#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:0e6fcaa4e63dd19c03","definition":"The time after the sun has set but when the sky is still lit by sunlight; the evening twilight period.","example":"Witnessing the dusk gives a feeling of solace.","pos":"noun","synonyms":["evenfall"],"antonyms":["dawn","daybreak"],"collocations":[],"usage":"","register":"countable, uncountable","wordFamily":["adusk","duskdarter","dusk-flat","duskhawk","duskish","duskless","dusklight","duskly","duskness","dusktime","predusk"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/dusk#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:c23accb7ec0626877f","definition":"A darkish colour.","example":"Whose dusk set off the whiteness of the skin.","pos":"noun","synonyms":["nightfall","smokefall","vespers","cockshut","crepusculum","dark","dimmity","duckish","dusk","mirkning","night","sun","sundown","sunset"],"antonyms":["dawn","daybreak"],"collocations":[],"usage":"","register":"countable, uncountable","wordFamily":["adusk","duskdarter","dusk-flat","duskhawk","duskish","duskless","dusklight","duskly","duskness","dusktime","predusk"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/dusk#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:ed4d9ce07a40a6cd68","definition":"The condition of being dusky; duskiness","example":"","pos":"noun","synonyms":["nightfall","smokefall","vespers","cockshut","crepus