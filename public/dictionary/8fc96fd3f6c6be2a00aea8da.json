{"term":"overnight","senses":[{"id":"kaikki:a407ef916115655b78","definition":"During or throughout the night, especially during the evening or night just past.","example":"Let it run overnight and we'll check on it in the morning.","pos":"adv","synonyms":[],"antonyms":[],"collocations":[],"usage":"not-comparable","register":"not-comparable","wordFamily":["girl rented overnight","nonovernight","overnight diaper","overnighter","overnight nappy"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/overnight#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:d839a0de58760fdb4d","definition":"In a very short (but unspecified) amount of time.","example":"The change seemed to happen overnight.","pos":"adv","synonyms":[],"antonyms":[],"collocations":[],"usage":"figuratively, not-comparable","register":"figuratively, not-comparable","wordFamily":["girl rented overnight","nonovernight","overnight diaper","overnighter","overnight nappy"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/overnight#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:67375940683d0487be","definition":"Occurring between dusk and dawn.","example":"The overnight ferry docked at 10 a.m.","pos":"adj","synonyms":[],"antonyms":[],"collocations":[],"usage":"not-comparable","register":"not-comparable","wordFamily":["girl rented overnight","nonovernight","overnight diaper","overnighter","overnight nappy","overnight bag","overnight case","overnight oats"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/overnight#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:7e6fde45d1f55150e4","definition":"Complete before the next morning.","example":"Don't expect overnight delivery.","pos":"adj","synonyms":[],"antonyms":[],"collocations":[],"usage":"not-comparable","re