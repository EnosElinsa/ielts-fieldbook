{"term":"notebook","senses":[{"id":"kaikki:a4e4e9f807b2e0f618","definition":"A book (physical or digital) in which notes or memoranda are written.","example":"Near-synonyms: notepad, rough book, writing pad, logbook, journal","pos":"noun","synonyms":["by-book","notepad","rough book","writing pad","logbook","journal"],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":["composition notebook","desknote","MacBook","notebinder","notebooker","notebookful","notebookish","notebookless","notebooklike","subnotebook"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/notebook#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:fc322d5a8b1b776f96","definition":"A kind of user interface in literate programming, allowing calculations to be interspersed with human-readable comments, diagrams, etc.","example":"We have found the use of Jupyter notebooks to be a convenient way of sharing work and code in a compact and reproducible manner. Jupyter notebooks are easy to update and adapt over time compared to a static CD-ROM.","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"attributive, sometimes","register":"attributive, sometimes","wordFamily":["composition notebook","desknote","MacBook","notebinder","notebooker","notebookful","notebookish","notebookless","notebooklike","subnotebook"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/notebook#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:d7d7954315c2f5428c","definition":"Ellipsis of notebook computer (“laptop computer”).","example":"Over time, the difference in size between laptops and notebooks became a matter of no more than an inch or two in length and width, and a fraction of an inch in thickness.","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"abbreviation, alt-of, ellipsis","register":"abbreviation, alt-of, ellipsis","wordFamily":["composition notebook","desknote","MacBook","notebinder","notebooker","notebookful","notebookish","notebookless","notebooklike","subnotebook"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/notebook#English","license":"CC-BY-SA-4.0"}],"pronunciation":{"ipa":"/ˈnəʊtˌbʊk/"},"wordFamily":["composition notebook","desknote","MacBook","notebinder","notebooker","notebookful","notebookish","notebookless","notebooklike","subnotebook"]}