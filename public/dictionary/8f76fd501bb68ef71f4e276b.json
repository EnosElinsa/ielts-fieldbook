{"term":"authority","senses":[{"id":"kaikki:9543a1b875a8bfcb58","definition":"Power or right to make or enforce rules, give orders, or impose obligation; or a position having such power or right.","example":"I have the authority to penalise the staff in my department, but not the authority to sack them.","pos":"noun","synonyms":["command","rulership","sovereignty","control"],"antonyms":["impotence","powerlessness"],"collocations":[],"usage":"","register":"uncountable","wordFamily":["aileron authority","antiauthority","appeal to authority","authoritah","authority control","authority figure","authority issues","authorityless","authoritywise","certificate authority","coauthority","color of authority","combined authority","elevator authority","enforcement authority","local authority","moral authority","multiauthority","port authority","postal authority","public authority","rudder authority","signature authority","statutory authority","tax authority","territorial authority","unitary authority","verbal authority"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/authority#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:ab3d1661dcb2f20b2a","definition":"Persons, regarded collectively, who occupy official positions of power; police or law enforcement.","example":"Authorities say the suspect fled on foot.","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"plural","register":"countable, plural, uncountable","wordFamily":["aileron authority","antiauthority","appeal to authority","authoritah","authority control","authority figure","authority issues","authorityless","authoritywise","certificate authority","coauthority","color of authority","combined authority","elevator authority","enforcement authority","local authority","moral authority","multiauthority","port authority","postal authority","public authority","rudder authority","signature authority","statutory authority","