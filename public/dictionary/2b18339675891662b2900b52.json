ise","dirt nap","doom","exit","expiration","fatality","liquidation","mortality","passing","quietus","repose","sleep of the just","sunset","the big sleep","crash","downfall","fall","(the) bane","(the) end"],"antonyms":[],"collocations":[],"usage":"figuratively","register":"countable, figuratively, uncountable","wordFamily":["amortality","attritional mortality","bill of mortality","catastrophic mortality","hypermortality","infant mortality","maternal mortality","morbimortality","mortality table","natimortality","overmortality","submortality"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/mortality#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:bd9978f43587b778a1","definition":"Mortals collectively.","example":"It is not fit Mortalitie should knowe / What his eternall prouidence decreed,","pos":"noun","synonyms":["humankind","humanity","mankind"],"antonyms":[],"collocations":[],"usage":"archaic, figuratively","register":"archaic, countable, figuratively, uncountable","wordFamily":["amortality","attritional mortality","bill of mortality","catastrophic mortality","hypermortality","infant mortality","maternal mortality","morbimortality","mortality table","natimortality","overmortality","submortality"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/mortality#English","license":"CC-BY-SA-4.0"}],"pronunciation":{"ipa":"/mɔɹˈtælɪti/","us":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/ff/En-us-mortality.ogg/En-us-mortality.ogg.mp3"},"wordFamily":["amortality","attritional mortality","bill of mortality","catastrophic mortality","hypermortality","infant mortality","maternal mortality","morbimortality","mortality table","natimortality","overmortality","submortality"]}