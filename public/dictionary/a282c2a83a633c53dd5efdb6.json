{"term":"at a time","senses":[{"id":"kaikki:0ef6249c8cc75c714c","definition":"In a single, continuous period of time.","example":"He manages to abstain from smoking for weeks at a time, but then gives in and starts again.","pos":"prep_phrase","synonyms":["in a row","at a stretch"],"antonyms":["individually","one at a time","piecemeal","separately","severally","singly"],"collocations":[],"usage":"","register":"","wordFamily":["one at a time"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/at_a_time#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:2c17f645347d539658","definition":"Simultaneously at each occurrence (of some action).","example":"climb stairs two at a time","pos":"prep_phrase","synonyms":["at once"],"antonyms":["individually","one at a time","piecemeal","separately","severally","singly"],"collocations":[],"usage":"","register":"","wordFamily":["one at a time"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/at_a_time#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:e2f34fc93847f3a364","definition":"Used other than figuratively or idiomatically: see at, a, time.","example":"We can't buy a new car at a time when we are already running low on money.","pos":"prep_phrase","synonyms":["at one time","at the same time","simultaneously","together"],"antonyms":["individually","one at a time","piecemeal","separately","severally","singly"],"collocations":[],"usage":"","register":"","wordFamily":["one at a time"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/at_a_time#English","license":"CC-BY-SA-4.0"}],"pronunciation":{},"wordFamily":["one at a time"]}