{"term":"amount","senses":[{"id":"kaikki:8eebc6c4fb6bd0e8b8","definition":"The total, aggregate or sum of material (not applicable to discrete numbers or units or items in standard English).","example":"The amount of atmospheric pollution threatens a health crisis.","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":["amount of substance","paramount"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/amount#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:0f9a9245336437f47b","definition":"A quantity or volume.","example":"Pour a small amount of water into the dish.","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":["amount of substance","paramount"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/amount#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:9e6f34ab259168b525","definition":"The number (the sum) of elements in a set.","example":"The final amount of students who have participated to mobility for the period 1995-1999 is held to be around 460 000.","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"nonstandard, proscribed, sometimes","register":"nonstandard, proscribed, sometimes","wordFamily":["amount of substance","paramount"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/amount#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:7eec8e163a3579ee15","definition":"To total or evaluate.","example":"The money in my pocket amounts to three dollars and change.","pos":"verb","synonyms":[],"antonyms":[],"collocations":[],"usage":"with-to","register":"intransitive, with-to","wordFamily":["amount of substance","paramount","extent","magnitude","measurement","number","quantity","size"],"source":"Engl