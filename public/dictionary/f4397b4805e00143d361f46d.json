{"term":"theory","senses":[{"id":"kaikki:3bb75a8eff9d560485","definition":"A description of an event or system that is considered to be accurate.","example":"As they encrease the hatred of vice in some, so doe they enlarge the theory of wickednesse in all.","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"countable, uncountable","wordFamily":["intertheory","in theory","intratheory","teletheory","theoretic","theorist","theorycel","theorycraft","theoryhead","theoryism","theory-laden","theoryless","time-preference theory of interest"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/theory#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:8fbfcfe051d8dcae9f","definition":"A coherent statement or set of ideas that explains observed facts or phenomena and correctly predicts new facts or phenomena not previously observed, or which sets out the laws and principles of something known or observed; a hypothesis confirmed by observation, experiment etc.","example":"In its most proper acceptation, theory means the completed result of philosophical induction from experience.","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"countable, uncountable","wordFamily":["intertheory","in theory","intratheory","teletheory","theoretic","theorist","theorycel","theorycraft","theoryhead","theoryism","theory-laden","theoryless","time-preference theory of interest"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/theory#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:0d898aaa25e2d34732","definition":"The underlying principles or methods of a given technical skill, art etc., as opposed to its practice.","example":"Lopukhov wrote a number of books and articles on ballet theory, as well as his memoirs.","pos":"noun","synonyms":[],"antonyms":["praxis"],"collocations":[],"usage":"","register":"uncountable","wordFamily":["intertheory","in theory","intratheory","teletheory","theoretic","theorist","theorycel","theorycraft","theoryhead","theoryism","theory-laden","theoryless","time-preference theory of interest"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/theory#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:6043d06a524f8c7a9a","definition":"A field of study attempting to exhaustively describe a particular class of constructs.","example":"Knot theory classifies the mappings of a circle into 3-space.","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"countable, uncountable","wordFamily":["intertheory","in theory","intratheory","teletheory","theoretic","theorist","theorycel","theorycraft","theoryhead","theoryism","theory-laden","theoryless","time-preference theory of interest"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/theory#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:7ac2f5dc634eb2d76a","definition":"A set of axioms together with all statements derivable from them; or, a set of statements which are deductively closed. Equivalently, a formal language plus a set of axioms (from which can then be derived theorems). The statements may be required to all be bound (i.e., to have no free variables).","example":"A theory is consistent if it has a model.","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"countable","wordFamily":["intertheory","in theory","intratheory","teletheory","theoretic","theorist","theorycel","theorycraft","theoryhead","theoryism","theory-laden","theoryless","time-preference theory of interest"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/theory#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:8fa15d30b9b0c22ed1","definition":"The standardization and study of fixed sequences of moves, especially in the opening phase of a game.","example":"Near-synonym: joseki","pos":"noun","synonyms":["joseki"],"antonyms":[],"collocations":[],"usage":"","register":"countable, uncountable","wordFamily":["intertheory","in theory","intratheory","teletheory","theoretic","theorist","theorycel","theorycraft","theoryhead","theoryism","theory-laden","theoryless","time-preference theory of interest"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/theory#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:7f2b492628560c1937","definition":"Mental conception; reflection, consideration.","example":"","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"obsolete","register":"countable, obsolete, uncountable","wordFamily":["intertheory","in theory","intratheory","teletheory","theoretic","theorist","theorycel","theorycraft","theoryhead","theoryism","theory-laden","theoryless","time-preference theory of interest"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/theory#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:ca492d86285683bc50","definition":"A hypothesis or conjecture.","example":"","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"informal","register":"countable, informal, uncountable","wordFamily":["intertheory","in theory","intratheory","teletheory","theoretic","theorist","theorycel","theorycraft","theoryhead","theoryism","theory-laden","theoryless","time-preference theory of interest"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/theory#English","license":"CC-BY-SA-4.0"}],"pronunciation":{"ipa":"/ˈθɪə.ɹi/","us":"https://upload.wikimedia.org/wikipedia/co