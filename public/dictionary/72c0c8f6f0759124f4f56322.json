{"term":"barren","senses":[{"id":"kaikki:b8ccab50478f7af617","definition":"Not bearing children, childless; hence also unable to bear children, sterile.","example":"I silently wept as my daughter's husband rejected her. What would she do now that she was no longer a maiden but also barren?","pos":"adj","synonyms":["sterile","fruitless"],"antonyms":["fertile","fruitful"],"collocations":[],"usage":"not-comparable","register":"not-comparable","wordFamily":["barren-ground caribou","barrenly","barrenness","barren strawberry","barrenwort","nonbarren","overbarren","semibarren","unbarren"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/barren#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:a731c2992713db127f","definition":"Not bearing seed or fruit.","example":"","pos":"adj","synonyms":["sterile","fruitless"],"antonyms":["fertile","fruitful"],"collocations":[],"usage":"not-comparable","register":"not-comparable","wordFamily":["barren-ground caribou","barrenly","barrenness","barren strawberry","barrenwort","nonbarren","overbarren","semibarren","unbarren"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/barren#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:651c4a1290d35f5a5d","definition":"Of poor fertility, infertile; not producing vegetation; desert, waste.","example":"barren mountain tracts","pos":"adj","synonyms":["sterile","fruitless"],"antonyms":["fertile","fruitful"],"collocations":[],"usage":"","register":"","wordFamily":["barren-ground caribou","barrenly","barrenness","barren strawberry","barrenwort","nonbarren","overbarren","semibarren","unbarren"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/barren#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:96b5fe6ca40211e4a7","definition":"Devoid, lacking.","example":"August 28, 1731, Jonathan Swift, letter to John Gay\nBut schemes are perfectly accidental. Some will appear barren of hints and matter, but prove to be fruitful.","pos":"adj","synonyms":["destitute","bereft"],"antonyms":["fertile","fruitful"],"collocations":[],"usage":"with-of","register":"with-of","wordFamily":["barren-ground caribou","barrenly","barrenness","barren strawberry","barrenwort","nonbarren","overbarren","semibarren","unbarren"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/barren#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:cef8a5f956ffe82c3e","definition":"Devoid of interest or attraction, poor, bleak.","example":"As they turned into Hertford Street they startled a robin from the poet's head on a barren fountain, and he fled away with a cameo note.","pos":"adj","synonyms":["sterile","fruitless"],"antonyms":["fertile","fruitful"],"collocations":[],"usage":"","register":"","wordFamily":["barren-ground caribou","barrenly","barrenness","barren strawberry","barrenwort","nonbarren","overbarren","semibarren","unbarren"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/barren#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:6d5eaec86fa880558d","definition":"Unproductive, fruitless, unprofitable; empty, hollow, vain.","example":"brilliant but barren reveries","pos":"adj","synonyms":["idle"],"antonyms":["fertile","fruitful"],"collocations":[],"usage":"","register":"","wordFamily":["barren-ground caribou","barrenly","barrenness","barren strawberry","barrenwort","nonbarren","overbarren","semibarren","unbarren"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/barren#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:9019f8eb4a84a4fb7c","definition":"Mentally dull or unproductive; stupid or intellectually fallow.","example":"Set on some quantity of barren spectators to laugh too.","pos":"adj","synonyms":["sterile","fruitless"],"antonyms":["fertile","fruitful"],"collocations":[],"usage":"","register":"","wordFamily":["barren-ground caribou","barrenly","barrenness","barren strawberry","barrenwort","nonbarren","overbarren","semibarren","unbarren"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/barren#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:3c3f559716dc553a6a","definition":"An area of low fertility and habitation, a desolate place.","example":"Sol squinted out over the barrens to where the mountains shimmered in the heat haze.","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":["barren-ground caribou","barrenly","barrenness","barren strawberry","barrenwort","nonbarren","overbarren","semibarren","unbarren","urchin barren"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/barren#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:6f13175a060574591b","definition":"In particular, a usually elevated and flat expanse of land that only supports the growth of small trees and shrubs, and sometimes mosses or heathers, berries, and other marshy or moory vegetation, but little agriculture and few people.","example":"The pine barrens are a site lonely enough to suit any hermit.","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"plural-normally","register":"plural-normally","wordFamily":["barren-ground caribou","barrenly","barrenness","barren strawberry","barrenwort","nonbarren","overbarren","semibarren","unbarren","urchin barren"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/barren#English","license":"CC-BY-SA-4.0"}],"pronunciation":{"ipa":"/ˈbæɹən/","us":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/97/En-us-barren.ogg/En-us-barren.ogg.mp3"},"wordFamily":["barren-ground caribou","barrenly","barrenness","barren strawberry","barrenwort","nonbarren","overbarren","semibarren","unbarren","urchin barren"]}