ual#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:1b112956a06131f847","definition":"State of being equal; equality.","example":"Thou that presum'st to weigh the world anew,\nAnd all things to an equall to restore.","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"obsolete","register":"countable, obsolete, uncountable","wordFamily":["balanced","equality"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/equal#English","license":"CC-BY-SA-4.0"}],"pronunciation":{"ipa":"/ˈiːkwəl/","us":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/b1/LL-Q1860_%28eng%29-Naomi_Persephone_Amethyst_%28NaomiAmethyst%29-equal.wav/LL-Q1860_%28eng%29-Naomi_Persephone_Amethyst_%28NaomiAmethyst%29-equal.wav.mp3"},"wordFamily":["balanced","equality"]}