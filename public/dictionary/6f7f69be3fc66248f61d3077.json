{"term":"saturate","senses":[{"id":"kaikki:f80c58ccb2338ef370","definition":"To cause to become completely permeated with, or soaked (especially with a liquid).","example":"Rain saturated their clothes.","pos":"verb","synonyms":["drench","impregnate","soak"],"antonyms":[],"collocations":[],"usage":"","register":"transitive","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/saturate#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:61a5bdaf6a42f52cae","definition":"To fill thoroughly or to excess.","example":"Modern television is saturated with violence.","pos":"verb","synonyms":[],"antonyms":[],"collocations":[],"usage":"figuratively","register":"figuratively, transitive","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/saturate#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:ce2dcc23e6d04a64b8","definition":"To satisfy the affinity of; to cause a substance to become inert by chemical combination with all that it can hold.","example":"One can saturate phosphorus with chlorine.","pos":"verb","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"transitive","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/saturate#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:09d3e20f429d7873d4","definition":"To render pure, or of a colour free from white light.","example":"","pos":"verb","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"transitive","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/saturate#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:75afd6ea20988cd7d6","definition":"Something saturated, especially a saturated fat.","exa