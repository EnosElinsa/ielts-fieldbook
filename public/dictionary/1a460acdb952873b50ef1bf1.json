{"term":"accessory","senses":[{"id":"kaikki:30a036c777d5b75444","definition":"Having a secondary, supplementary or subordinate function by accompanying as a subordinate; aiding in a secondary way; being additional; contributing or being contributory.","example":"accessory garments","pos":"adj","synonyms":["accompanying","contributory","auxiliary","subsidiary","subservient","additional","acceding"],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/accessory#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:c272dd0a76010baf04","definition":"Assisting a crime without actually participating in committing the crime itself; being connected as an incident or subordinate to a principal.","example":"Her actions were clearly accessory because they helped him commit and probably also conceal the crime.","pos":"adj","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/accessory#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:8ca04812ef5cfcf17a","definition":"Present in a minor amount, and not essential.","example":"accessory mineral","pos":"adj","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/accessory#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:6ae60d480254c6bc2d","definition":"Supernumerary and generally nonfunctional.","example":"She had an accessory finger on one hand.","pos":"adj","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"