aic","wordFamily":["gendervague","nonvague","unvague","vagueblog","vaguebook","vagueish","vaguery","vaguish"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/vague#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:31ef5c1262dd766c92","definition":"To become vague or act in a vague manner.","example":"Vaguely, yes. I've vagued all my life; that's been my curse.","pos":"verb","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":["gendervague","nonvague","unvague","vagueblog","vaguebook","vagueish","vaguery","vaguish"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/vague#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:be557d14e8027c724f","definition":"To make vague negative comments publicly; to make highly veiled complaints or insults.","example":"","pos":"verb","synonyms":["vaguepost"],"antonyms":[],"collocations":[],"usage":"Internet","register":"Internet, intransitive","wordFamily":["gendervague","nonvague","unvague","vagueblog","vaguebook","vagueish","vaguery","vaguish"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/vague#English","license":"CC-BY-SA-4.0"}],"pronunciation":{"ipa":"/veɪɡ/","uk":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/e0/En-uk-vague.ogg/En-uk-vague.ogg.mp3","us":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/2b/En-us-vague.ogg/En-us-vague.ogg.mp3"},"wordFamily":["gendervague","nonvague","unvague","vagueblog","vaguebook","vagueish","vaguery","vaguish"]}