{"term":"fill in","senses":[{"id":"kaikki:fe4a028d5e96708141","definition":"To fill; to replace material that is absent or has been removed.","example":"After you're done laying the pipe, fill in the trench.","pos":"verb","synonyms":[],"antonyms":[],"collocations":[],"usage":"idiomatic","register":"idiomatic, transitive","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/fill_in#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:19820f65ef3c919ed2","definition":"To inform somebody, especially to supply someone missing or missed information.","example":"If you know anything about this, maybe you can fill me in.","pos":"verb","synonyms":[],"antonyms":[],"collocations":[],"usage":"idiomatic","register":"idiomatic, transitive","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/fill_in#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:b89d6ba0da98ee28c4","definition":"To substitute for somebody or something.","example":"He can't go on vacation very often because there is nobody to fill in for him.","pos":"verb","synonyms":[],"antonyms":[],"collocations":[],"usage":"idiomatic","register":"idiomatic, intransitive","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/fill_in#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:0c8e6524b0d017a723","definition":"To complete a form or questionnaire with requested information.","example":"I've got a form that is to be filled in in ink.","pos":"verb","synonyms":["fill out"],"antonyms":[],"collocations":[],"usage":"UK, idiomatic","register":"UK, idiomatic, transitive","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/fill_in#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:4fe5be4c6f0f2278c3","definition":"To beat up; to physically assault.","example":"Talk to me like that again and I'll fill you in!","pos":"verb","synonyms":[],"antonyms":[],"collocations":[],"usage":"idiomatic, slang","register":"idiomatic, slang","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/fill_in#English","license":"CC-BY-SA-4.0"}],"pronunciation":{"us":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/90/En-au-fill_in.ogg/En-au-fill_in.ogg.mp3"},"wordFamily":[]}