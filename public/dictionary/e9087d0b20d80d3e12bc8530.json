{"term":"ferry","senses":[{"id":"kaikki:bdb67cb1cf9fe4b097","definition":"To carry; transport; convey.","example":"Trucks plowed through the water to ferry flood victims to safety.","pos":"verb","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"transitive","wordFamily":["unferried"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/ferry#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:9636f9bb1a43e326dd","definition":"To move someone or something from one place to another, usually repeatedly.","example":"Being a good waiter takes more than the ability to ferry plates of food around a restaurant.","pos":"verb","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"transitive","wordFamily":["unferried"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/ferry#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:580a54ed6c60f916c2","definition":"To carry or transport over a contracted body of water, as a river or strait, in a boat or other floating conveyance plying between opposite shores.","example":"","pos":"verb","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"transitive","wordFamily":["unferried"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/ferry#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:0ea67c7f68f1f55f5b","definition":"To pass over water in a boat or by ferry.","example":"They ferry over this Lethean sound / Both to and fro.","pos":"verb","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"intransitive","wordFamily":["unferried"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/ferry#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:974a27c35