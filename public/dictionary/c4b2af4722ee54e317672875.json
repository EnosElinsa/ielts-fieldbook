{"term":"agency","senses":[{"id":"kaikki:35b275a430a49d82cb","definition":"The capacity, condition, or state of acting or of exerting power.","example":"A few advances there are in the following papers tending to assert the superintendence and agency of Providence in the natural world.","pos":"noun","synonyms":["action","activity","operation"],"antonyms":["nonagency"],"collocations":[],"usage":"","register":"countable, uncountable","wordFamily":["agencylike","agencywide","inter-agency"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/agency#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:a0b3ff2c8ca3b7abf9","definition":"The capacity of individuals to act independently and to make their own free choices.","example":"moral agency","pos":"noun","synonyms":["action","activity","agency","agent","agentship","cause","device","force","function","means","operation","power"],"antonyms":["nonagency"],"collocations":[],"usage":"","register":"countable, uncountable","wordFamily":["agencylike","agencywide","inter-agency"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/agency#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:f6c794226fa37c1cd9","definition":"A medium through which power is exerted or an end is achieved.","example":"","pos":"noun","synonyms":["instrumentality","means"],"antonyms":["nonagency"],"collocations":[],"usage":"","register":"countable, uncountable","wordFamily":["agencylike","agencywide","inter-agency"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/agency#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:d8af9b9faed3f340e9","definition":"The office or function of an agent; also, the relationship between a principal and that person's agent.","example":"authority of agency","pos":"noun","synonyms":["action","activity","agency","agent","agentship","cause","device","force","function","means","operation","power"],"antonyms":["nonagency"],"collocations":[],"usage":"","register":"countable, uncountable","wordFamily":["agencylike","agencywide","inter-agency"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/agency#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:fcc01b933420f231eb","definition":"An establishment engaged in doing business for another; also, the place of business or the district of such an agency.","example":"As an employment agency you have a responsibility to supply work to the individual agency worker, as well as a service to the client.","pos":"noun","synonyms":["management"],"antonyms":["nonagency"],"collocations":[],"usage":"","register":"countable, uncountable","wordFamily":["agencylike","agencywide","inter-agency"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/agency#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:92db7b24f6001cb8b7","definition":"A department or other administrative unit of a government; also, the office or headquarters of, or the district administered by, such unit of government.","example":"Agency for Toxic Substances and Disease Registry","pos":"noun","synonyms":["organ","service"],"antonyms":["nonagency"],"collocations":[],"usage":"","register":"countable, uncountable","wordFamily":["agencylike","agencywide","inter-agency"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/agency#English","license":"CC-BY-SA-4.0"}],"pronunciation":{"ipa":"/ˈeɪ.d͡ʒən.si/","us":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/2e/En-us-agency.ogg/En-us-agency.ogg.mp3"},"wordFamily":["agencylike","agencywide","inter-agency"]}