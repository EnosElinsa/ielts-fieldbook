English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/process#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:33908b5bb4af42f040","definition":"To think about a piece of information, or a concept, in order to assimilate it, and perhaps accept it in a modified state.","example":"I didn't know she had a criminal record. That will take me a while to process.","pos":"verb","synonyms":[],"antonyms":[],"collocations":[],"usage":"figuratively","register":"figuratively, transitive","wordFamily":["proceed","procedure","autoprocess","bioprocess","geoprocess","hydroprocess","lyoprocess","misprocess","overprocess","photoprocess","postprocess","preprocess","processability","processable","processed","processible","processor","reprocess","subprocess","underprocess","unprocessability","wordprocess"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/process#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:7af0c74e84ea4bb4ea","definition":"To develop photographic film.","example":"","pos":"verb","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"transitive","wordFamily":["proceed","procedure","autoprocess","bioprocess","geoprocess","hydroprocess","lyoprocess","misprocess","overprocess","photoprocess","postprocess","preprocess","processability","processable","processed","processible","processor","reprocess","subprocess","underprocess","unprocessability","wordprocess"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/process#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:8d542db5dc26a14b8e","definition":"To take legal proceedings against.","example":"When I saw that he would not let me alone, I processed him for £12. My mother was with his brother John, and he allowed her six guineas for clothes; and if she did not want the money, he would allow it to me in the rent, and I made him pay that when he would not leave me alone.","pos":"verb","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"transitive","wordFamily":["proceed","procedure","autoprocess","bioprocess","geoprocess","hydroprocess","lyoprocess","misprocess","overprocess","photoprocess","postprocess","preprocess","processability","processable","processed","processible","processor","reprocess","subprocess","underprocess","unprocessability","wordprocess"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/process#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:04bceb82901b184078","definition":"To walk in a procession, especially in a liturgical context.","example":"Prayers completed and Psalms ending, patriarch, emperor, and their sumptuously clad entourages move past the open, silver-clad wings of the Imperial Door and process into the crowded nave and continue to the sanctuary at the east.","pos":"verb","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":["proceed","procedure","autoprocess","bioprocess","geoprocess","hydroprocess","lyoprocess","misprocess","overprocess","photoprocess","postprocess","preprocess","processability","processable","processed","processible","processor","reprocess","subprocess","underprocess","unprocessability","wordprocess"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/process#English","license":"CC-BY-SA-4.0"}],"pronunciation":{"ipa":"/ˈpɹəʊ.sɛs/","uk":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/93/LL-Q1860_%28eng%29-Back_ache-process.wav/LL-Q1860_%28eng%29-Back_ache-process.wav.mp3","us":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/60/En-us-process.ogg/En-us-process.ogg.mp3"},"wordFamily":["proceed","procedure","autoprocess","bioprocess","geoprocess","hydroprocess","lyoprocess","misprocess"