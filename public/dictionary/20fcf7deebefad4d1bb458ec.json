{"term":"trespass","senses":[{"id":"kaikki:5a0ada67a299b17748","definition":"An intentional interference with another's property or person.","example":"External infrastructure issues such as severe weather and trespass caused 17.1% of [train] cancellations, [...].","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"countable, uncountable","wordFamily":["anti-trespass","antitrespass","cybertrespass","light trespass","trespass offering","trespass on the case","trespassory","trespass to chattels"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/trespass#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:3e5421fb65598a38f8","definition":"sin","example":"Forgive us our trespasses, as we forgive those who trespass against us","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"archaic","register":"archaic, countable, uncountable","wordFamily":["anti-trespass","antitrespass","cybertrespass","light trespass","trespass offering","trespass on the case","trespassory","trespass to chattels"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/trespass#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:f74a62e652c6497b93","definition":"To commit an offence; to sin.","example":"In the time of his distress did he trespass yet more against the Lord.","pos":"verb","synonyms":["transgress"],"antonyms":[],"collocations":[],"usage":"archaic","register":"archaic, intransitive","wordFamily":["anti-trespass","antitrespass","cybertrespass","light trespass","trespass offering","trespass on the case","trespassory","trespass to chattels","nontrespass","trespassee","trespasser","untrespassed"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/trespass#English","license":"CC-BY-SA-4.0"},{"id":"ka