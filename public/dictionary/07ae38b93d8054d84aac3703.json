{"term":"pilot","senses":[{"id":"kaikki:639104f0d719caf07a","definition":"A person who steers a ship, a helmsman.","example":"They scud before the wind, and sail in open sea.\n Ahead of all the master pilot steers;\n And, as he leads, the following navy veers.","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/pilot#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:245883e18510a81c0d","definition":"A person who knows well the depths, shoals, and currents of a harbor or coastal area, who is hired by a vessel to help navigate the harbor or coast.","example":"","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/pilot#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:99508723fa2f19e9b4","definition":"A guide book for maritime navigation.","example":"","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/pilot#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:78f39685697dee7a1b","definition":"An instrument for detecting the compass error.","example":"","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/pilot#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:3248d03f55484d7310","definition":"A pilot vehicle.","example":"","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"Australia, informal","register":"Australia, informal","word