{"term":"pour","senses":[{"id":"kaikki:9f1c23007ff2094274","definition":"To cause (liquid, or liquid-like substance) to flow in a stream, either out of a container or into it.","example":"pour water from a jug","pos":"verb","synonyms":["shink","skink"],"antonyms":[],"collocations":[],"usage":"","register":"transitive","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/pour#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:6dbdf30154917c8aab","definition":"To send out as in a stream or a flood; to cause (an emotion) to come out; to cause to escape.","example":"My teacher poured scorn on my attempts at writing.","pos":"verb","synonyms":["shink","skink"],"antonyms":[],"collocations":[],"usage":"figuratively","register":"figuratively, transitive","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/pour#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:03ba8482760e906235","definition":"To send forth from, as in a stream; to discharge uninterruptedly.","example":"Is it for thee the linnet pours his throat?","pos":"verb","synonyms":["shink","skink"],"antonyms":[],"collocations":[],"usage":"","register":"transitive","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/pour#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:47ea887e052c8aaa3e","definition":"To flow, pass, or issue in a stream; to fall continuously and abundantly.","example":"the rain poured down.","pos":"verb","synonyms":["shink","skink"],"antonyms":[],"collocations":[],"usage":"","register":"intransitive","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/pour#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:e171394454195fc38c","definition":"To rain hard.","example":"It's pouring outside.","pos":"verb","synonyms":["spate"],"antonyms":[],"collocations":[],"usage":"impersonal","register":"impersonal","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/pour#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:8ea60b57e0a596fd09","definition":"Of a beverage, to be on tap or otherwise available for serving to customers.","example":"","pos":"verb","synonyms":["shink","skink"],"antonyms":[],"collocations":[],"usage":"","register":"intransitive","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/pour#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:6697672355834f9e17","definition":"To move in a throng, as a crowd.","example":"The people poured out of the theater.","pos":"verb","synonyms":["sweep","crowd","throng"],"antonyms":[],"collocations":[],"usage":"","register":"intransitive","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/pour#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:e9fbd595f0953b98ff","definition":"To move (a drunk or unsteady person) into or out of a place or vehicle.","example":"She poured him into a taxi and handed the driver the fare.","pos":"verb","synonyms":["shink","skink"],"antonyms":[],"collocations":[],"usage":"","register":"transitive","wordFamily":[],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/pour#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:667a62de95e1383fb8","definition":"The act of pouring.","example":"The bartender's inexpert pour left me with a pint of beer that was half foam.","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":["med pour","rainpour"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/pour#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:fb0477bf3d3b8ac023","definition":"Something, or an amount, poured.","example":"Over this time period, the first concrete pour has not only lost workability but has started to set so that it is no longer affected by the action of a vibrator.","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"","register":"","wordFamily":["med pour","rainpour"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/pour#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:afa48ec79c224cab7c","definition":"A downpour; a flood of precipitation.","example":"Then, as if to give the lie to the offensive insinuation, he mounted his horse, and rode home ten miles in a pour of rain, without a great coat or umbrella.","pos":"noun","synonyms":[],"antonyms":[],"collocations":[],"usage":"colloquial","register":"colloquial","wordFamily":["med pour","rainpour"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/pour#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:d17103ea7d2ab88713","definition":"Misspelling of pore.","example":"","pos":"verb","synonyms":[],"antonyms":[],"collocations":[],"usage":"alt-of, misspelling","register":"alt-of, misspelling","wordFamily":["med pour","rainpour"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/pour#English","license":"CC-BY-SA-4.0"}],"pronunciation":{"ipa":"/pɔː/","us":"https://upload.wikimedia.org/wikipedia/commons/transcoded/1/1d/En-us-pour.ogg/En-us-pour.ogg.mp3"},"wordFamily":["med pour","rainpour"]}