{"term":"absorb","senses":[{"id":"kaikki:9cfebb50e0e983dc6b","definition":"To include so that it no longer has separate existence; to overwhelm; to cause to disappear as if by swallowing up; to incorporate; to assimilate; to take in and use up.","example":"Dark oblivion soon absorbs them all.","pos":"verb","synonyms":["assimilate","engulf","incorporate","swallow up","overwhelm"],"antonyms":["emit"],"collocations":[],"usage":"","register":"transitive","wordFamily":["absorbability","absorbable","absorbance","absorbate","absorbefacient","absorbent","absorb oneself in","absorption","absorptive","bioabsorb","misabsorb","overabsorb","preabsorb","reabsorb","X-ray absorbing glass"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/absorb#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:408349c95bd613d20b","definition":"To engulf, as in water; to swallow up.","example":"to be absorpt, or swallowed up, in a lake of fire and brimstone.","pos":"verb","synonyms":["bear","pay for","take in"],"antonyms":["emit"],"collocations":[],"usage":"obsolete","register":"obsolete, transitive","wordFamily":["absorbability","absorbable","absorbance","absorbate","absorbefacient","absorbent","absorb oneself in","absorption","absorptive","bioabsorb","misabsorb","overabsorb","preabsorb","reabsorb","X-ray absorbing glass"],"source":"English Wiktionary via Kaikki.org","attribution":"English Wiktionary contributors","sourceUrl":"https://en.wiktionary.org/wiki/absorb#English","license":"CC-BY-SA-4.0"},{"id":"kaikki:9e96158ab652b3f205","definition":"To suck up; to drink in; to imbibe, like a sponge or as the lacteals of the body; to chemically take in.","example":"","pos":"verb","synonyms":["draw","drink in","imbibe","soak up","sop up","suck","suck up","steep","take in","take up"],"antonyms":["emit"],"collocations":[],"usage":"","register":"transitive","wordFamily":["absorbability","absorbable","absorbance","absorbat