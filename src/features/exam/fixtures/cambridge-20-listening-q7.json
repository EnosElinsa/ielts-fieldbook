    "evidence": {
      "end": 320.149,
      "text": "Anyway, it’s had excellent reviews from all the newspapers.",
      "start": 316,
      "sentenceId": "source:88906"
    },
    "provenance": {
      "fetchedAt": "2026-10-11T16:04:19.949Z",
