      "end": 341.149,
      "text": "Well, you could go for the set lunch. That’s quite reasonable for a top class restaurant: 30 a head.",
      "start": 335.55,
      "sentenceId": "source:88910"
    },
    "provenance": {
      "fetchedAt": "2026-10-11T16:04:19.949Z",
