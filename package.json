{
  "name": "ielts-fieldbook",
  "version": "1.0.0",
  "description": "IELTS writing and speaking practice notebook (React + Vite + Supabase).",
  "license": "MIT",
  "author": "Zhiyuan Cai",
  "repository": {
    "type": "git",
    "url": "https://github.com/EnosElinsa/ielts-fieldbook.git"
  },
  "keywords": [
    "ielts",
    "react",
    "typescript",
    "vite",
    "supabase",
    "writing",
    "speaking"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "seed:bank": "node scripts/seed-bank.mjs",
    "deploy:pages": "npm run build && npx wrangler pages deploy dist --project-name ielts-fieldbook",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "22.20.4",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "3.0.5"
  }
}
