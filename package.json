{
  "name": "ielts-fieldbook",
  "version": "1.0.0",
  "description": "English-only IELTS study workspace for writing, speaking and vocabulary, with feedback-linked practice and spaced review.",
  "license": "MIT",
  "author": "Zhiyuan Cai",
  "repository": {
    "type": "git",
    "url": "https://github.com/EnosElinsa/ielts-fieldbook.git"
  },
  "keywords": [
    "ielts",
    "react",
    "typescript",
    "vite",
    "supabase",
    "writing",
    "speaking",
    "vocabulary",
    "spaced-repetition",
    "fsrs"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "seed:bank": "node scripts/seed-bank.mjs",
    "seed:vocabulary": "node scripts/seed-vocabulary.mjs",
    "enrich:vocabulary": "node scripts/enrich-vocabulary.mjs",
    "fetch:vocabulary-dictionary": "node scripts/fetch-open-vocabulary.mjs",
    "deploy:pages": "npm run build && npx wrangler pages deploy dist --project-name ielts-fieldbook",
    "test": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "lucide-react": "^1.54.0",
    "motion": "^14.0.0",
    "papaparse": "^5.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "recharts": "^3.10.1",
    "ts-fsrs": "^5.4.2",
    "wavesurfer.js": "^8.0.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "22.20.4",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "parse5": "^7.3.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "3.0.5"
  }
}
